# ABOUTME: Docker ignore file to keep build context small.
# ABOUTME: Excludes development files, tests, and version control from the Docker image.

**/*.log
**/*.md
**/*.php~
**/*.dist.php
**/*.dist
**/*.cache
**/._*
**/.dockerignore
**/.DS_Store
**/.git/
**/.gitattributes
**/.gitignore
**/.gitmodules
**/compose.*.yaml
**/compose.*.yml
**/compose.yaml
**/compose.yml
**/docker-compose.*.yaml
**/docker-compose.*.yml
**/docker-compose.yaml
**/docker-compose.yml
**/Dockerfile
**/Thumbs.db
.claude/
.github/
.gitea/
docs/
mate/
public/bundles/
tests/
var/
vendor/
.mcp.json
.editorconfig
.env.*.local
.env.local
.env.local.php
.env.test

# The end-user help manual (docs-user/) is built into the prod image at public/help. Its Markdown
# content is the source the Astro build consumes, so re-include it - the broad **/*.md rule above
# would otherwise strip it from the build context. Keep installed deps and build output out; both
# are (re)generated inside the help-docs builder stage.
!docs-user/**/*.md
docs-user/node_modules/
docs-user/dist/
