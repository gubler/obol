# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# Two connection strings for two database roles (reference/adr/0030). DATABASE_URL is the runtime
# role the whole application runs on - Doctrine, the session handler and the cache pool all read it -
# and it cannot change the schema. MIGRATION_DATABASE_URL is the role that owns the schema, used by
# the `migrations` connection and nothing else.
#
# Host-side defaults. Inside the Docker stack, compose.yaml overrides both to point at the `database`
# service; in CI the workflow sets them to its service.
DATABASE_URL="postgresql://obol_app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
MIGRATION_DATABASE_URL="postgresql://obol_owner:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
#MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
###< symfony/messenger ###

###> symfony/mailer ###
# Committed default is a no-op: nothing leaves the host until you set a real DSN.
# For local/early dev, point this at Fastmail SMTP with an app password in .env.local:
#   MAILER_DSN=smtp://you%40dev88.co:APP_PASSWORD@smtp.fastmail.com:465
# (URL-encode the @ in the username as %40; the external-host/Resend switch is Phase 1.3.)
# Verify wiring with `mise run dce -- php bin/console app:mailer:smoke you@dev88.co`.
MAILER_DSN=null://null
# Default sender for transactional mail. Use a real, authorized sender in prod / .env.local.
MAILER_FROM="Obol <noreply@dev88.co>"
###< symfony/mailer ###

###> web-auth/webauthn-symfony-bundle ###
# Passkeys (WebAuthn).
#   WEBAUTHN_RP_ID              the relying-party id - a registrable-domain suffix of the origin,
#                               WITHOUT scheme or port (e.g. `obol.dev88.co`). Passkeys bind to this,
#                               so it must stay stable across deploys or existing passkeys stop working.
#                               Pin it to the apex/registrable domain, NOT a subdomain host: an apex
#                               rp-id keeps passkeys valid if the app later moves onto a subdomain
#                               (e.g. app.<domain>), whereas a host-scoped rp-id locks them to one host
#                               and cannot be changed after registration (ADR-0018).
#   WEBAUTHN_ALLOWED_ORIGINS    the exact origin(s) browsers send during a ceremony (scheme + host + port).
#
# These committed values are development defaults and never reach production: the prod overlay derives
# both from APP_HOST in the deploy environment, and a real environment variable wins over this file.
# They target the local Lolly dev origin (https://obol.lolly.localhost); `localhost` is a valid rp-id
# suffix of that host and also covers solo-mode loopback (http://localhost:8080). Override both in
# .env.local for a worktree with a different SERVER_NAME.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ALLOWED_ORIGINS=https://obol.lolly.localhost
###< web-auth/webauthn-symfony-bundle ###

###> symfony/routing ###
# Origin for building absolute URLs in non-HTTP contexts (CLI commands and the async worker),
# where there is no request to derive the host from - magic-link and verification links are minted
# on the worker. Left empty here on purpose: the value depends on how the stack is running, so it
# is set by the compose overlay bin/dc selects - http://localhost:<port> in solo mode and
# https://<SERVER_NAME> in shared mode. Production builds it from APP_HOST instead, since SERVER_NAME
# there is the Caddy listen address (`:80`) rather than a hostname. Tests pin it in .env.test.
DEFAULT_URI=
###< symfony/routing ###
