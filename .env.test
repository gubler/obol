# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999

# Tests must never reach a real SMTP transport. null:// makes every send a no-op,
# guarding against a real MAILER_DSN leaking in from the environment.
MAILER_DSN=null://null

###> symfony/panther ###
# Run Panther's spawned PHP CLI server in the test env (not the recipe's default
# `panther`) so it shares the app_test database with the test process. The browser
# tests use #[SkipDatabaseRollback] + factory seeding, so committed rows are visible
# across the process boundary (see docs/development/testing.md, Browser tests).
PANTHER_APP_ENV=test
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
###< symfony/panther ###
