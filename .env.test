# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999

# Off-request absolute-URL origin. Pinned here so the suite is deterministic: locally the compose
# overlay sets DEFAULT_URI in the container and this is overridden; in CI there is no overlay, so
# this is the source. DefaultUriTest reads whichever value is live and asserts the router uses it.
DEFAULT_URI=https://obol.test

# Tests must never reach a real SMTP transport. null:// makes every send a no-op,
# guarding against a real MAILER_DSN leaking in from the environment.
MAILER_DSN=null://null
MAILER_FROM="Obol <noreply@dev88.test>"

###> web-auth/webauthn-symfony-bundle ###
# Passkey ceremonies in the test env. rp-id `localhost` matches Panther's spawned CLI server, which
# tests/bootstrap.php pins to localhost:9080 (Chromium rejects IP-literal RP IDs as an invalid domain).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:9080
###< web-auth/webauthn-symfony-bundle ###

###> symfony/panther ###
# Run Panther's spawned PHP CLI server in the test env (not the recipe's default
# `panther`) so it shares the app_test database with the test process. The browser
# tests use #[SkipDatabaseRollback] + factory seeding, so committed rows are visible
# across the process boundary (see docs/development/testing.md, Browser tests).
PANTHER_APP_ENV=test
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
###< symfony/panther ###
