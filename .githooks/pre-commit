#!/usr/bin/env bash
# ABOUTME: Git pre-commit hook that blocks direct commits to main and runs the fast check sprint.
# ABOUTME: Style runs in check mode (CI parity); on failure run `mise run cs` to fix, then re-stage.

set -uo pipefail

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

if [ "$BRANCH" = "main" ]; then
    echo "Direct commits to main are not allowed. Use a feature branch." >&2
    exit 1
fi

# shellcheck source=.githooks/lib.sh
. "$(dirname "$0")/lib.sh"

fast_checks
