#!/usr/bin/env bash
# ABOUTME: Git pre-push hook that runs the full check set on every push, via mise.
# ABOUTME: Aggregates failures so one run surfaces them all instead of fix-rerun loops.

set -uo pipefail

# Run every check and aggregate failures (no `set -e`) so one run surfaces them all.
# Pushes are gated locally on the same suite CI runs, catching failures before the
# server round-trip. (main is PR-only, so there is no branch-specific gating here.)
status=0
mise run lint:php      || status=1
mise run cs:check      || status=1
mise run cs:twig:check || status=1
mise run sa            || status=1
mise run test          || status=1
exit "$status"
