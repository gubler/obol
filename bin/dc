#!/usr/bin/env sh
# ABOUTME: Thin wrapper around `docker compose` — applies --env-file .env.local and
# ABOUTME: auto-picks compose.solo.yaml vs compose.shared.yaml by probing the dev-proxy network.

set -eu

COMPOSE_ARGS=""
if [ -f .env.local ]; then
    COMPOSE_ARGS="--env-file .env.local"
fi

if docker network inspect dev-proxy >/dev/null 2>&1; then
    MODE_FILE="compose.shared.yaml"
else
    MODE_FILE="compose.solo.yaml"
fi

export COMPOSE_FILE="compose.yaml:compose.override.yaml:${MODE_FILE}"

exec docker compose ${COMPOSE_ARGS} "$@"
