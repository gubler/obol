{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "beberlei/assert": "^3.3.4",
        "doctrine/dbal": "^4.5.0",
        "doctrine/doctrine-bundle": "^3.3.3",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/orm": "^3.7.5",
        "dragonmantank/cron-expression": "^3.6.1",
        "knplabs/knp-time-bundle": "^2.5",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "phpstan/phpdoc-parser": "^2.3.6",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "^2.11",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^4.1.0",
        "symfony/process": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/scheduler": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/stimulus-bundle": "^3.6",
        "symfony/string": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/ux-chartjs": "^3.6",
        "symfony/ux-icons": "^3.6",
        "symfony/ux-turbo": "^3.6",
        "symfony/ux-twig-component": "^3.6",
        "symfony/validator": "8.1.*",
        "symfony/web-link": "8.1.*",
        "symfony/yaml": "8.1.*",
        "symfonycasts/tailwind-bundle": "^0.14",
        "twig/cssinliner-extra": "^3.26",
        "twig/extra-bundle": "^3.29.0",
        "twig/intl-extra": "^3.30",
        "twig/twig": "^3.30.0",
        "web-auth/webauthn-symfony-bundle": "^5.3.9",
        "zenstruck/foundry": "^2.14.1"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.7",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "helgesverre/toon": "^3.2.1",
        "igor-php/igor-php": "0.9.2",
        "infection/infection": "^0.34.2",
        "matesofmate/composer-extension": "^0.4",
        "matesofmate/phpstan-extension": "^0.4",
        "matesofmate/phpunit-extension": "^0.4",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.2",
        "phpstan/phpstan-beberlei-assert": "^2.0.2",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpstan/phpstan-symfony": "^2.1.0",
        "phpunit/phpunit": "^13.4.3",
        "rector/rector": "^2.7.0",
        "spaze/phpstan-disallowed-calls": "^4.15.0",
        "symfony/ai-mate": "^0.11",
        "symfony/ai-monolog-mate-extension": "^0.11",
        "symfony/ai-symfony-mate-extension": "^0.11",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.68.0",
        "symfony/panther": "^2.4",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*",
        "symplify/phpstan-rules": "~14.15.3",
        "tomasvotruba/type-coverage": "^2.5.1",
        "vincentlanglet/twig-cs-fixer": "^4.1.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "symfony/ai-mate-composer-plugin": false
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "App\\Mate\\": "mate/src/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "install-hooks": "git rev-parse --git-dir >/dev/null 2>&1 && git config --local core.hooksPath .githooks || true",
        "post-install-cmd": [
            "@auto-scripts",
            "@install-hooks"
        ],
        "post-update-cmd": [
            "@auto-scripts",
            "@install-hooks"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^8.1",
            "docker": true
        },
        "ai-mate": {
            "extension": false,
            "scan-dirs": [
                "mate/src"
            ],
            "includes": [
                "mate/config.php"
            ]
        }
    }
}
