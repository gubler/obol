# Template for the production deploy environment file.
#
# Copy this to the host, fill in the real values, and point COMPOSE_ENV_FILES at it (bin/dc-prod
# defaults to /etc/obol/deploy.env). It must NOT live in the checkout: pinning COMPOSE_ENV_FILES is
# what stops Compose from falling back to the repo's own `.env`, whose dev defaults would otherwise
# satisfy the ${VAR:?} guards below and boot production with a no-op mailer and a localhost passkey
# relying party.
#
# The placeholder values here are the ones bin/prod-compose-check renders against, so this file and
# the compose contract cannot drift apart. `.example` is a reserved TLD, so `obol.example` can never
# resolve to anything real.

# The application's public identity: what users type, what appears in magic-link emails, and what
# passkeys bind to. Everything origin-shaped is derived from it.
APP_HOST=obol.example

# Signs magic links, remember-me cookies and email-verification URIs. A known value is a full auth
# compromise - generate a unique one per host, e.g. `openssl rand -hex 32`.
APP_SECRET=CHANGE_ME_generate_a_unique_random_value

# The database name, and the cluster's bootstrap superuser. That superuser provisions the two roles
# below on first boot and is then used by nothing else - not the application, not the migrations. It
# is the break-glass credential and the one a restore runs under, so it stays out of every container
# but the database's own.
POSTGRES_USER=obol
POSTGRES_DB=obol
POSTGRES_PASSWORD=CHANGE_ME_generate_a_unique_random_value

# The two roles the application connects as (reference/adr/0030). The owner owns the schema and runs
# migrations; the runtime role has data rights only and cannot create, alter or drop anything - so a
# SQL injection reaches the rows a request could touch anyway, and not the schema. Generate a
# separate value for each; both feed the DSNs the base compose assembles.
OBOL_DB_OWNER_PASSWORD=CHANGE_ME_generate_a_unique_random_value
OBOL_DB_RUNTIME_PASSWORD=CHANGE_ME_generate_a_unique_random_value

# Outbound transactional mail. Magic links are the only way into the application, so a dropped send
# is a lockout - there is deliberately no fallback here.
MAILER_DSN=smtp://CHANGE_ME%40obol.example:CHANGE_ME@smtp.obol.example:465
MAILER_FROM="Obol <noreply@obol.example>"

# The image to run. Pin a released tag rather than `latest` so a restart can never pull something
# unreviewed, and so a rollback is one line here plus `bin/dc-prod up -d`.
OBOL_IMAGE=code.dev88.work/dev88/obol:0000.0.0-replace-with-a-released-tag

# Cloudflare Tunnel connector credential, from the tunnel's dashboard page. This is the only ingress:
# the stack publishes no ports.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_tunnel_token_from_the_cloudflare_dashboard

# The relying-party id passkeys bind to. Defaults to APP_HOST and should stay unset: it is pinned to
# the registrable apex, and APP_HOST is that apex. Set it only if the application is ever served from
# a subdomain, in which case this must keep its original apex value - a passkey cannot be rebound
# after registration. See reference/adr/0018.
#WEBAUTHN_RP_ID=obol.example

# The role names, if the defaults do not suit. Changing either after the cluster is initialized means
# re-running the provisioning script; the old role is left behind rather than renamed.
#OBOL_DB_OWNER=obol_owner
#OBOL_DB_RUNTIME=obol_app

# Complete database DSNs, overriding the ones composed from the parts above. Only needed to point the
# application at a database outside this stack - and then both are needed, since the privilege split
# has to survive the move. The first names the runtime role, the second the owner.
#DATABASE_URL_OVERRIDE=postgresql://obol_app:password@host:5432/obol?serverVersion=16&charset=utf8
#MIGRATION_DATABASE_URL_OVERRIDE=postgresql://obol_owner:password@host:5432/obol?serverVersion=16&charset=utf8
