{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:obol.lolly.localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	root /app/public
	encode zstd br gzip

	vulcain

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
	header ?Permissions-Policy "browsing-topics=()"
	header ?Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# nosniff on every response, including static files (uploaded logos, compiled assets) served by
	# the file_server below, which bypasses PHP. The app sets it too on dynamic responses; `?` yields
	# to a header already present, so the two never conflict. Document-scoped headers (CSP, frame,
	# referrer) live in the Symfony response listener, which can be tested and covers only PHP routes.
	header ?X-Content-Type-Options "nosniff"

	# .webmanifest is not in Caddy's MIME table (it falls back to text/plain); the PWA spec
	# wants application/manifest+json so the manifest validates without a Content-Type warning.
	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"

	# Content-addressed output only: AssetMapper digests compiled asset filenames, and the help
	# manual's build digests everything under its _astro directory. Both change name whenever they
	# change content, so a year-long immutable policy can never serve something stale. The manual's
	# own pages are deliberately excluded - their URLs are stable, so an immutable copy in a reader's
	# browser could not be replaced by any later deploy. They keep ETag revalidation.
	#
	# Requiring the file to exist is what confines this to production and keeps it clear of PHP. Both
	# directories are populated only by the image build, so in development - where AssetMapper serves
	# /assets through PHP - nothing matches and a developer never caches their own edits for a year.
	# It is also the exact inverse of the @phpRoute matcher below, so dynamic responses keep the
	# private, must-revalidate policy Symfony sets on them.
	@immutable {
		path /assets/* /help/_astro/*
		file {path}
	}
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@phpRoute {
		not path /.well-known/mercure*
		not file {path}
	}
	rewrite @phpRoute index.php

	@frontController path index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}

		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}

	file_server {
		hide *.php
	}
}
