{
    "compilerOptions": {
        "checkJs": true,
        "noEmit": true,
        "module": "esnext",
        "target": "esnext",
        "moduleResolution": "bundler",
        "lib": ["esnext", "dom", "dom.iterable"],
        "strict": false,
        "skipLibCheck": true,
        "maxNodeModuleJsDepth": 0,
        "types": []
    },
    "include": ["assets/**/*.js", "types/**/*.d.ts"],
    "exclude": [
        "assets/vendor/**",
        "assets/controllers/csrf_protection_controller.js",
        "node_modules"
    ]
}
