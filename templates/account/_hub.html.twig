{# ABOUTME: Two-column shell for the account hub - a data-driven left sidebar and the active section. #}
{# ABOUTME: Sections extend this and fill {% block section %}; add one via the `sections` list + a route. #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'account.hub.title'|trans }}{% endblock %}

{% block header %}
    <h1 class="text-3xl font-bold tracking-tight text-header-fg">{{ 'account.hub.title'|trans }}</h1>
{% endblock %}

{% block body %}
    {# Adding a section is a single entry here plus its route + template - no layout change. `match`
       lists the route-name prefixes that light this item up (its own routes and any that post to it). #}
    {% set current_route = app.request.attributes.get('_route') %}
    {% set sections = [
        {label: 'account.hub.nav.preferences'|trans, route: 'account_preferences', match: ['account_preferences']},
        {label: 'account.hub.nav.access'|trans, route: 'account_access', match: ['account_access', 'account_email', 'account_passkey']},
    ] %}

    <div class="flex flex-col gap-6 md:flex-row">
        <nav class="md:w-56 md:shrink-0" aria-label="{{ 'account.hub.title'|trans }}">
            <ul class="flex gap-1 overflow-x-auto md:flex-col md:gap-0.5" data-test="account-hub-nav">
                {% for section in sections %}
                    {% set active = false %}
                    {% for prefix in section.match %}
                        {% if current_route starts with prefix %}{% set active = true %}{% endif %}
                    {% endfor %}
                    <li>
                        <a href="{{ path(section.route) }}"
                           class="block whitespace-nowrap rounded-md px-3 py-2 text-sm font-medium {{ active ? 'bg-brand/10 text-brand' : 'text-fg/70 hover:bg-surface-2 hover:text-fg' }}"
                           {% if active %}aria-current="page"{% endif %}
                           data-test="account-hub-nav-link">
                            {{ section.label }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </nav>

        <div class="min-w-0 grow">
            {# Flashes for the non-framed sections render here, once, rather than in each section template.
               The Preferences edit saves inside the #account-preferences Turbo Frame, whose swap replaces
               only the frame - a flash out here would be discarded. On a Turbo-Frame request the frame
               renders the flash itself (see preferences/show + edit); the bag is consumed on read, so the
               header guard hands it to exactly one place per request and it never double-renders. #}
            {% if app.request.headers.get('Turbo-Frame') is null %}
                {{ include('components/_flashes.html.twig', with_context: false) }}
            {% endif %}

            {% block section %}{% endblock %}
        </div>
    </div>
{% endblock %}
