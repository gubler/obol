{% extends 'base.html.twig' %}

{% block title %}{{ 'account.email.verify_error.title'|trans }}{% endblock %}

{% block body %}
    <div class="container mx-auto max-w-md px-4 py-8">
        <h1 class="mb-2 text-3xl font-bold">{{ 'account.email.verify_error.heading'|trans }}</h1>
        <p class="mb-6 text-fg/70" data-test="email-verify-error" data-test-reason="{{ reason }}">
            {{ ('account.email.verify_error.' ~ reason)|trans }}
        </p>

        <a href="{{ path('app_login') }}" class="text-sm text-brand hover:text-brand-strong hover:underline">
            {{ 'account.email.verify_error.back'|trans }}
        </a>
    </div>
{% endblock %}
