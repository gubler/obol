{# ABOUTME: The admin hub's System Toggles section - runtime system settings, one checkbox per toggle. #}
{# ABOUTME: Behind the ROLE_ADMIN gate; the form posts to itself and redirects on save (see ADR-0020). #}
{% extends 'admin/_hub.html.twig' %}

{% block section %}
    <section class="bg-surface shadow-md rounded p-6">
        <h2 class="text-lg font-semibold text-fg">{{ 'admin.system_toggles.heading'|trans }}</h2>
        <p class="mt-1 mb-4 text-sm text-fg/70">{{ 'admin.system_toggles.intro'|trans }}</p>

        {{ form_start(form, {attr: {'data-test': 'system-toggles-form'}}) }}
            <div class="space-y-4">
                <div class="flex items-start gap-3">
                    {{ form_widget(form.publicSignupEnabled, {attr: {'data-test': 'system-toggles-public-signup'}}) }}
                    <div>
                        {{ form_label(form.publicSignupEnabled) }}
                        {{ form_help(form.publicSignupEnabled) }}
                    </div>
                </div>
            </div>

            <div class="mt-6">
                <button type="submit"
                        class="bg-brand hover:bg-brand-strong text-on-brand text-sm font-medium py-2 px-3 rounded"
                        data-test="system-toggles-submit">
                    {{ 'admin.system_toggles.submit'|trans }}
                </button>
            </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
