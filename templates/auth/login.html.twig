{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.login.title'|trans }}{% endblock %}

{% block body %}
    <div class="container mx-auto max-w-md px-4 py-8">
        <h1 class="mb-2 text-3xl font-bold">{{ 'auth.login.heading'|trans }}</h1>
        <p class="mb-6 text-fg/70">{{ 'auth.login.intro'|trans }}</p>

        {% for message in app.flashes('notice') %}
            <div class="flash-notice bg-success-surface border border-success text-success px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}

        {% if lastAuthError %}
            <div class="flash-error bg-danger-surface border border-danger text-danger px-4 py-3 rounded mb-4">
                {{ lastAuthError.messageKey|trans(lastAuthError.messageData, 'security') }}
            </div>
        {% endif %}

        <div class="bg-surface shadow-md rounded p-6"
             data-controller="passkey-login"
             data-passkey-login-options-url-value="{{ path('webauthn.controller.security.main.request.options') }}"
             data-passkey-login-result-url-value="{{ path('webauthn.controller.security.main.request.result') }}"
             data-passkey-login-error-message-value="{{ 'auth.passkey.login.error'|trans }}">
            {{ form_start(form, {attr: {class: 'space-y-6'}}) }}
                {# autocomplete="username webauthn" lets the browser offer registered passkeys in the
                   email field's autofill dropdown (conditional UI), driven by passkey_login_controller. #}
                {{ form_row(form.email, {attr: {autocomplete: 'username webauthn'}}) }}
                <button type="submit" class="w-full bg-brand hover:bg-brand-strong text-on-brand font-bold py-2 px-4 rounded">
                    {{ 'auth.login.submit'|trans }}
                </button>
            {{ form_end(form) }}

            {# Opt-in fast path. Hidden until Stimulus confirms JS + WebAuthn are available; the magic-link
               form above stays the always-working fallback. #}
            <button type="button"
                    class="hidden mt-3 w-full border border-brand text-brand hover:bg-brand/10 font-medium py-2 px-4 rounded"
                    data-passkey-login-target="button"
                    data-action="passkey-login#authenticate"
                    data-test="passkey-login-submit">
                {{ 'auth.passkey.login.button'|trans }}
            </button>

            <p hidden role="status"
               class="mt-2 text-center text-sm text-danger"
               data-passkey-login-target="status"></p>
        </div>
    </div>
{% endblock %}
