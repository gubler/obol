<!DOCTYPE html>
<html lang="en" class="h-full bg-page text-fg">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}{{ 'common.title.default'|trans }}{% endblock %}</title>
        <link rel="icon" type="image/svg+xml" href="{{ asset('icons/obol-coin.svg') }}">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
        <link rel="apple-touch-icon" href="/apple-touch-icon.png">
        {# Resolve the theme before paint so there is no flash: dark unless a light choice is
           stored or the OS prefers light. Kept in sync with resolveTheme in theme_controller.js. #}
        <script>
            (function () {
                var stored = localStorage.getItem('theme');
                var light = stored === 'light' || (!stored && window.matchMedia('(prefers-color-scheme: light)').matches);
                document.documentElement.classList.toggle('dark', !light);
            })();
        </script>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="h-full">
    <div class="min-h-full">
        <div class="relative bg-header pb-32">
            <nav class="bg-header">
                <div class="mx-auto max-w-7xl sm:px-6 lg:px-8">
                    <div class="border-b border-white/10">
                        <div class="flex h-16 items-center justify-between px-4 sm:px-0">
                            <div class="flex items-center">
                                <div class="shrink-0">
                                    <a href="{{ path('subscription_index') }}">
                                        <img src="{{ asset('icons/obol-coin.svg') }}" alt="Obol" class="size-8" />
                                    </a>
                                </div>
                                <div class="hidden md:block">
                                    <div class="ml-10 flex items-baseline space-x-4">
                                        <a href="{{ path('subscription_index') }}" class="rounded-md px-3 py-2 text-sm font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.subscriptions'|trans }}</a>
                                        <a href="{{ path('category_index') }}" class="rounded-md px-3 py-2 text-sm font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.categories'|trans }}</a>
                                        <a href="{{ path('reports_index') }}" class="rounded-md px-3 py-2 text-sm font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.reports'|trans }}</a>
                                    </div>
                                </div>
                            </div>
                            <div class="-mr-2 flex items-center gap-1">
                                <button type="button" data-controller="theme" data-action="theme#toggle" aria-label="{{ 'common.theme.toggle'|trans }}" aria-pressed="false" class="relative inline-flex items-center justify-center rounded-md p-2 text-header-muted hover:bg-white/5 hover:text-header-fg focus:outline-2 focus:outline-offset-2 focus:outline-brand">
                                    <span class="sr-only">{{ 'common.theme.toggle'|trans }}</span>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6 dark:hidden">
                                        <path d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="hidden size-6 dark:block">
                                        <path d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </button>
                                <!-- Mobile menu button -->
                                <button type="button" command="--toggle" commandfor="mobile-menu" class="relative inline-flex items-center justify-center rounded-md p-2 text-header-muted hover:bg-white/5 hover:text-header-fg focus:outline-2 focus:outline-offset-2 focus:outline-brand md:hidden">
                                    <span class="absolute -inset-0.5"></span>
                                    <span class="sr-only">{{ 'common.menu.open'|trans }}</span>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 in-aria-expanded:hidden">
                                        <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 not-in-aria-expanded:hidden">
                                        <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <el-disclosure id="mobile-menu" hidden class="block border-b border-white/10 md:hidden">
                    <div class="space-y-1 px-2 py-3 sm:px-3">
                        <a href="{{ path('subscription_index') }}" class="block rounded-md px-3 py-2 text-base font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.subscriptions'|trans }}</a>
                        <a href="{{ path('category_index') }}" class="block rounded-md px-3 py-2 text-base font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.categories'|trans }}</a>
                        <a href="{{ path('reports_index') }}" class="block rounded-md px-3 py-2 text-base font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.reports'|trans }}</a>
                    </div>
                </el-disclosure>
            </nav>
            <header class="py-10">
                <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                    {% block header %} {% endblock %}
                </div>
            </header>
        </div>

        <main class="relative -mt-32">
            <div class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
                <div class="rounded-lg bg-surface px-5 py-6 shadow-sm sm:px-6">
                    {% block body %}{% endblock %}
                </div>
            </div>
        </main>
    </div>
    </body>
</html>
