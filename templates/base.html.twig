<!DOCTYPE html>
<html lang="en" class="h-full bg-page text-fg">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}{{ 'common.title.default'|trans }}{% endblock %}</title>
        <link rel="icon" type="image/svg+xml" href="{{ asset('icons/obol-coin.svg') }}">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
        <link rel="apple-touch-icon" href="/apple-touch-icon.png">
        {# Resolve the theme before paint so there is no flash: dark unless a light choice is
           stored or the OS prefers light. Kept in sync with resolveTheme in theme_controller.js. #}
        <script>
            (function () {
                var stored = localStorage.getItem('theme');
                var light = stored === 'light' || (!stored && window.matchMedia('(prefers-color-scheme: light)').matches);
                document.documentElement.classList.toggle('dark', !light);
            })();
        </script>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="h-full">
    {% if app.user %}
        {% set tour_labels = {
            subscriptions: {title: 'tour.step.subscriptions.title'|trans, body: 'tour.step.subscriptions.body'|trans},
            add: {title: 'tour.step.add.title'|trans, body: 'tour.step.add.body'|trans},
            totals: {title: 'tour.step.totals.title'|trans, body: 'tour.step.totals.body'|trans},
            categories: {title: 'tour.step.categories.title'|trans, body: 'tour.step.categories.body'|trans},
            reports: {title: 'tour.step.reports.title'|trans, body: 'tour.step.reports.body'|trans},
            theme: {title: 'tour.step.theme.title'|trans, body: 'tour.step.theme.body'|trans},
        } %}
    {% endif %}
    <div class="min-h-full"{% if app.user %} data-controller="tour" data-tour-labels-value="{{ tour_labels|json_encode }}"{% endif %}>
        <div class="relative bg-header pb-32">
            <nav class="bg-header">
                <div class="mx-auto max-w-7xl sm:px-6 lg:px-8">
                    <div class="border-b border-white/10">
                        <div class="flex h-16 items-center justify-between px-4 sm:px-0">
                            <div class="flex items-center">
                                <div class="shrink-0">
                                    <a href="{{ path('subscription_index') }}">
                                        <img src="{{ asset('icons/obol-coin.svg') }}" alt="Obol" class="size-8" />
                                    </a>
                                </div>
                                {% if app.user %}
                                <div class="hidden md:block">
                                    <div class="ml-10 flex items-baseline space-x-4">
                                        <a href="{{ path('subscription_index') }}" data-tour="subscriptions" class="rounded-md px-3 py-2 text-sm font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.subscriptions'|trans }}</a>
                                        <a href="{{ path('category_index') }}" data-tour="categories" class="rounded-md px-3 py-2 text-sm font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.categories'|trans }}</a>
                                        <a href="{{ path('payment_source_index') }}" class="rounded-md px-3 py-2 text-sm font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.payment_sources'|trans }}</a>
                                        <a href="{{ path('reports_index') }}" data-tour="reports" class="rounded-md px-3 py-2 text-sm font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.reports'|trans }}</a>
                                        {% if is_granted('ROLE_ADMIN') %}
                                        <a href="{{ path('admin_index') }}" data-test="nav-admin" class="rounded-md px-3 py-2 text-sm font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.admin'|trans }}</a>
                                        {% endif %}
                                    </div>
                                </div>
                                {% endif %}
                            </div>
                            <div class="-mr-2 flex items-center gap-1">
                                {% if app.user %}
                                    <a href="{{ path('account_preferences') }}" class="hidden items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium text-header-muted hover:bg-white/5 hover:text-header-fg md:inline-flex" data-test="nav-account">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-5">
                                            <path d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.24-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.281Z" stroke-linecap="round" stroke-linejoin="round" />
                                            <path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                        {{ 'common.nav.account'|trans }}
                                    </a>
                                    <span class="hidden px-2 text-sm text-header-muted md:inline" title="{{ app.user.userIdentifier }}">{{ app.user.displayName }}</span>
                                    <a href="{{ path('app_logout') }}" class="rounded-md px-3 py-2 text-sm font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.logout'|trans }}</a>
                                {% endif %}
                                <button type="button" data-controller="theme" data-action="theme#toggle" data-tour="theme" aria-label="{{ 'common.theme.toggle'|trans }}" aria-pressed="false" class="relative inline-flex items-center justify-center rounded-md p-2 text-header-muted hover:bg-white/5 hover:text-header-fg focus:outline-2 focus:outline-offset-2 focus:outline-brand">
                                    <span class="sr-only">{{ 'common.theme.toggle'|trans }}</span>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6 dark:hidden">
                                        <path d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="hidden size-6 dark:block">
                                        <path d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </button>
                                <!-- Mobile menu button -->
                                {% if app.user %}
                                <button type="button" command="--toggle" commandfor="mobile-menu" class="relative inline-flex items-center justify-center rounded-md p-2 text-header-muted hover:bg-white/5 hover:text-header-fg focus:outline-2 focus:outline-offset-2 focus:outline-brand md:hidden">
                                    <span class="absolute -inset-0.5"></span>
                                    <span class="sr-only">{{ 'common.menu.open'|trans }}</span>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 in-aria-expanded:hidden">
                                        <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 not-in-aria-expanded:hidden">
                                        <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                {% if app.user %}
                <el-disclosure id="mobile-menu" hidden class="block border-b border-white/10 md:hidden">
                    <div class="space-y-1 px-2 py-3 sm:px-3">
                        <a href="{{ path('subscription_index') }}" class="block rounded-md px-3 py-2 text-base font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.subscriptions'|trans }}</a>
                        <a href="{{ path('category_index') }}" class="block rounded-md px-3 py-2 text-base font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.categories'|trans }}</a>
                        <a href="{{ path('payment_source_index') }}" class="block rounded-md px-3 py-2 text-base font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.payment_sources'|trans }}</a>
                        <a href="{{ path('reports_index') }}" class="block rounded-md px-3 py-2 text-base font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.reports'|trans }}</a>
                        {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin_index') }}" class="block rounded-md px-3 py-2 text-base font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.admin'|trans }}</a>
                        {% endif %}
                        <a href="{{ path('account_preferences') }}" class="block rounded-md px-3 py-2 text-base font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.account'|trans }}</a>
                        <a href="{{ path('app_logout') }}" class="block rounded-md px-3 py-2 text-base font-medium text-header-muted hover:bg-white/5 hover:text-header-fg">{{ 'common.nav.logout'|trans }}</a>
                    </div>
                </el-disclosure>
                {% endif %}
            </nav>
            <header class="{% block header_padding %}py-10{% endblock %}">
                <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                    {% block header %} {% endblock %}
                </div>
            </header>
        </div>

        <main class="relative -mt-32">
            <div class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
                <div class="rounded-lg bg-surface px-5 py-6 shadow-sm sm:px-6">
                    {% block body %}{% endblock %}
                </div>
            </div>
        </main>

        {% if app.user %}
        <footer class="mx-auto max-w-7xl px-4 pb-10 sm:px-6 lg:px-8">
            <div class="flex flex-col items-center justify-between gap-2 border-t border-line pt-6 text-sm text-fg-muted sm:flex-row">
                <p>&copy; {{ 'now'|date('Y') }} Obol</p>
                {# The tour highlights the dashboard, so it can only run there; offer it only there rather
                   than hook nothing (or force a navigation away) from other pages. #}
                {% if app.request.attributes.get('_route') == 'subscription_index' %}
                    <button type="button" data-action="tour#start" class="font-medium text-brand hover:text-brand-strong">{{ 'tour.footer.link'|trans }}</button>
                {% endif %}
            </div>
        </footer>
        {% endif %}
    </div>
    </body>
</html>
