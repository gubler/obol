{% extends 'base.html.twig' %}

{% block title %}Edit Category{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="mb-6">
            <a href="{{ path('category_show', {id: category.id}) }}" class="text-brand hover:text-brand-strong mb-4 inline-block">&larr; Back to Category</a>
            <h1 class="text-3xl font-bold">Edit Category</h1>
        </div>

        <div class="bg-surface shadow-md rounded p-6 max-w-2xl">
            {{ form_start(form, {attr: {class: 'space-y-6'}}) }}

            <div>
                {{ form_label(form.name, null, {label_attr: {class: 'block text-sm font-medium text-fg mb-2'}}) }}
                {{ form_widget(form.name, {attr: {class: 'mt-1 block w-full rounded-md border-line shadow-sm focus:border-brand focus:ring-brand sm:text-sm'}}) }}
                {% if form.name.vars.errors|length > 0 %}
                    <div class="form-error text-danger text-sm mt-1">
                        {{ form_errors(form.name) }}
                    </div>
                {% endif %}
            </div>

            <div class="flex justify-end space-x-3">
                <a href="{{ path('category_show', {id: category.id}) }}" class="bg-surface-2 hover:bg-line text-fg font-bold py-2 px-4 rounded">
                    Cancel
                </a>
                <button type="submit" class="bg-brand hover:bg-brand-strong text-on-brand font-bold py-2 px-4 rounded">
                    Save
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
