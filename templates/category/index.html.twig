{% extends 'base.html.twig' %}

{% block title %}Categories{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold">Categories</h1>
            <a href="{{ path('category_new') }}" class="bg-brand hover:bg-brand-strong text-on-brand font-bold py-2 px-4 rounded">
                New Category
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="flash-success bg-success-surface border border-success text-success px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}

        {% if categories|length > 0 %}
            <div class="bg-surface shadow-md rounded overflow-hidden">
                <table class="min-w-full divide-y divide-line">
                    <thead class="bg-surface-2">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-fg-muted uppercase tracking-wider">Name</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-fg-muted uppercase tracking-wider">Subscriptions</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-fg-muted uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-surface divide-y divide-line">
                        {% for category in categories %}
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="flex items-center gap-2">
                                        {{ include('category/_badge.html.twig', {category: category}) }}
                                        {{ category.name }}
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">{{ category.subscriptions|length }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <a href="{{ path('category_show', {id: category.id}) }}" class="text-brand hover:text-brand-strong mr-3">View</a>
                                    <a href="{{ path('category_edit', {id: category.id}) }}" class="text-brand hover:text-brand-strong">Edit</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="empty-state bg-surface-2 border border-line rounded-lg px-6 py-12 text-center">
                <p class="text-fg-muted text-lg">No categories found</p>
                <p class="text-fg-muted mt-2">Get started by creating your first category</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
