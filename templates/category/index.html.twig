{% extends 'base.html.twig' %}

{% block title %}{{ 'category.index.title'|trans }}{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <h1 class="text-3xl font-bold">{{ 'category.index.heading'|trans }}</h1>
            <a href="{{ path('category_new') }}" class="self-start bg-brand hover:bg-brand-strong text-on-brand font-bold py-2 px-4 rounded sm:self-auto">
                {{ 'category.action.new'|trans }}
            </a>
        </div>

        {{ include('components/_flashes.html.twig', with_context: false) }}

        {% if categories|length > 0 %}
            <div class="bg-surface shadow-md rounded overflow-x-auto">
                <table class="min-w-full divide-y divide-line">
                    <thead class="bg-surface-2">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-fg-muted uppercase tracking-wider">{{ 'category.index.col_name'|trans }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-fg-muted uppercase tracking-wider">{{ 'category.index.col_subscriptions'|trans }}</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-fg-muted uppercase tracking-wider">{{ 'category.index.col_actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="bg-surface divide-y divide-line">
                        {% for category in categories %}
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="flex items-center gap-2">
                                        {{ include('category/_badge.html.twig', {category: category}) }}
                                        {{ category.name }}
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">{{ category.subscriptions|length }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <a href="{{ path('category_show', {id: category.id}) }}" class="text-brand hover:text-brand-strong mr-3">{{ 'common.action.view'|trans }}</a>
                                    <a href="{{ path('category_edit', {id: category.id}) }}" class="text-brand hover:text-brand-strong">{{ 'common.action.edit'|trans }}</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="empty-state bg-surface-2 border border-line rounded-lg px-6 py-12 text-center">
                <p class="text-fg-muted text-lg">{{ 'category.empty.title'|trans }}</p>
                <p class="text-fg-muted mt-2">{{ 'category.empty.subtitle'|trans }}</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
