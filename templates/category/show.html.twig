{% extends 'base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="mb-6">
            <a href="{{ path('category_index') }}" class="text-brand hover:text-brand-strong mb-4 inline-block">&larr; {{ 'category.show.back'|trans }}</a>
            <h1 class="flex items-center gap-3 text-3xl font-bold">
                {{ include('category/_badge.html.twig', {category: category}) }}
                {{ category.name }}
            </h1>
        </div>

        {% for message in app.flashes('success') %}
            <div class="flash-success bg-success-surface border border-success text-success px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="flash-error bg-danger-surface border border-danger text-danger px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}

        <div class="bg-surface shadow-md rounded p-6 mb-6">
            <div class="flex justify-between items-center">
                <h2 class="text-xl font-semibold">{{ 'category.show.details_heading'|trans }}</h2>
                <div class="space-x-2">
                    <a href="{{ path('category_edit', {id: category.id}) }}" class="bg-brand hover:bg-brand-strong text-on-brand font-bold py-2 px-4 rounded">
                        {{ 'common.action.edit'|trans }}
                    </a>
                    <form action="{{ path('category_delete', {id: category.id}) }}" method="POST" class="inline-block" data-turbo-confirm="{{ 'category.show.delete_confirm'|trans }}">
                        <button type="submit" class="bg-danger text-white hover:opacity-90 font-bold py-2 px-4 rounded">
                            {{ 'common.action.delete'|trans }}
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="bg-surface shadow-md rounded p-6">
            <h2 class="text-xl font-semibold mb-4">{{ 'category.show.subscriptions_heading'|trans }}</h2>

            {% if category.subscriptions|length > 0 %}
                <ul class="divide-y divide-line">
                    {% for subscription in category.subscriptions %}
                        <li class="py-3">
                            <div class="flex justify-between items-center">
                                <span class="text-fg">{{ subscription.name }}</span>
                                <span class="text-fg-muted">{{ subscription.cost.format() }} / {{ 'subscription.cadence'|trans({count: subscription.paymentPeriodCount, period: subscription.paymentPeriod.value}) }}</span>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-fg-muted">{{ 'category.show.no_subscriptions'|trans }}</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
