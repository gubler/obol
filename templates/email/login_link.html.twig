{# Magic-link login email (HTML). All copy is translatable per ADR-0012. #}
<h1>{{ 'auth.email.login_link.heading'|trans }}</h1>

<p>{{ 'auth.email.login_link.body'|trans }}</p>

<p>
    <a href="{{ loginLinkUrl }}">{{ 'auth.email.login_link.cta'|trans }}</a>
</p>

<p>{{ 'auth.email.login_link.expiry'|trans({'%when%': expiresAt|time_diff}) }}</p>

<p>{{ 'auth.email.login_link.ignore'|trans }}</p>
