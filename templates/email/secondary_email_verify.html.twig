{# Secondary-email verification email (HTML). All copy is translatable per ADR-0012. #}
{% extends 'email/base_email.html.twig' %}

{% block content %}
    <h1>{{ 'account.email.verify.heading'|trans }}</h1>

    <p>{{ 'account.email.verify.body'|trans }}</p>

    <p>
        <a class="email-button" href="{{ verifyUrl }}">{{ 'account.email.verify.cta'|trans }}</a>
    </p>

    <p class="email-fineprint">{{ 'account.email.verify.expiry'|trans({'%when%': expiresAt|time_diff}) }}</p>

    <p class="email-fineprint">{{ 'account.email.verify.ignore'|trans }}</p>
{% endblock %}
