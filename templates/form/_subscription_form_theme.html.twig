{# ABOUTME: Custom form theme blocks for the subscription forms. #}
{# ABOUTME: Renders the TileColor field as selectable swatch chips and gives the file input a bordered box with a styled Browse button. #}
{% block tile_color_widget %}
    <div class="grid grid-cols-6 gap-2 sm:grid-cols-9">
        {% for choice in form %}
            <div class="relative">
                {{ form_widget(choice, {attr: {class: 'sr-only peer'}}) }}
                <label for="{{ choice.vars.id }}"
                       title="{{ choice.vars.label }}"
                       class="block h-9 w-full cursor-pointer rounded-lg {{ choice.vars.attr['data-gradient'] }} ring-2 ring-transparent ring-offset-2 ring-offset-surface transition peer-checked:ring-brand peer-focus-visible:ring-brand-strong">
                    <span class="sr-only">{{ choice.vars.label }}</span>
                </label>
            </div>
        {% endfor %}
    </div>
{% endblock %}

{# The @tailwindcss/forms plugin leaves file inputs borderless; give it the same bordered box as the text inputs, plus a styled Browse button via the file: pseudo-element. #}
{% block file_widget %}
    {# Match the token-themed text inputs (square corners, line border, brand focus) so the box fits; the file: classes style the Browse button against the tokens. #}
    {% set widget_class = widget_class|default('mt-1 block w-full cursor-pointer border border-line bg-surface-2 text-sm text-fg-muted file:mr-3 file:cursor-pointer file:border-0 file:bg-surface-2 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-fg hover:file:bg-line focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand') %}
    {{ block('form_widget_simple') }}
{% endblock %}
