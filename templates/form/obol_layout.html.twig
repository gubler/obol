{# ABOUTME: Global form theme - Symfony's tailwind_2_layout recolored with the Obol design tokens. #}
{# ABOUTME: Overrides only the label/help/error colors (the vendor theme hardcodes gray/red) so form chrome follows light/dark. #}
{% use 'tailwind_2_layout.html.twig' %}

{%- block form_label -%}
    {%- set label_class = label_class|default('block text-fg') -%}
    {{- parent() -}}
{%- endblock %}

{%- block form_help -%}
    {%- set help_class = help_class|default('mt-1 text-fg-muted') -%}
    {{- parent() -}}
{%- endblock %}

{%- block form_errors -%}
    {%- set error_item_class = error_item_class|default('text-danger') -%}
    {{- parent() -}}
{%- endblock %}
