{% extends 'base.html.twig' %}

{% block title %}Edit Payment - {{ payment.subscription.name }}{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="mb-6">
            <a href="{{ path('subscription_show', {id: payment.subscription.id}) }}" class="text-brand hover:text-brand-strong mb-4 inline-block">&larr; Back to {{ payment.subscription.name }}</a>
            <h1 class="text-3xl font-bold">Edit Payment</h1>
            <p class="text-fg-muted mt-1">for {{ payment.subscription.name }}</p>
        </div>

        <div class="bg-surface shadow-md rounded p-6 max-w-2xl">
            {{ form_start(form, {attr: {class: 'space-y-6'}}) }}

            {{ form_widget(form) }}

            <div class="flex justify-end space-x-3">
                <a href="{{ path('subscription_show', {id: payment.subscription.id}) }}" class="bg-surface-2 hover:bg-line text-fg font-bold py-2 px-4 rounded">
                    Cancel
                </a>
                <button type="submit" class="bg-brand hover:bg-brand-strong text-on-brand font-bold py-2 px-4 rounded">
                    Save
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
