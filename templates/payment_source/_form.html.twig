{# ABOUTME: Shared field layout for the payment source create/edit forms: name, comment, color swatch picker. #}
{% form_theme form 'form/_subscription_form_theme.html.twig' %}

<div>
    {{ form_label(form.name, null, {label_attr: {class: 'block text-sm font-medium text-fg mb-2'}}) }}
    {{ form_widget(form.name, {attr: {class: 'mt-1 block w-full rounded-md border-line shadow-sm focus:border-brand focus:ring-brand sm:text-sm'}}) }}
    {% if form.name.vars.errors|length > 0 %}
        <div class="form-error text-danger text-sm mt-1">
            {{ form_errors(form.name) }}
        </div>
    {% endif %}
</div>

<div>
    {{ form_label(form.comment, null, {label_attr: {class: 'block text-sm font-medium text-fg mb-2'}}) }}
    {{ form_widget(form.comment, {attr: {class: 'mt-1 block w-full rounded-md border-line shadow-sm focus:border-brand focus:ring-brand sm:text-sm', rows: 3}}) }}
</div>

<div>
    {{ form_label(form.color, null, {label_attr: {class: 'block text-sm font-medium text-fg mb-2'}}) }}
    {{ form_widget(form.color) }}
</div>
