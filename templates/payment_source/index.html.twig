{% extends 'base.html.twig' %}

{% block title %}{{ 'payment_source.index.title'|trans }}{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <h1 class="text-3xl font-bold">{{ 'payment_source.index.heading'|trans }}</h1>
            <a href="{{ path('payment_source_new') }}" class="self-start bg-brand hover:bg-brand-strong text-on-brand font-bold py-2 px-4 rounded sm:self-auto">
                {{ 'payment_source.action.new'|trans }}
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="flash-success bg-success-surface border border-success text-success px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}

        {% if payment_sources|length > 0 %}
            <div class="bg-surface shadow-md rounded overflow-x-auto">
                <table class="min-w-full divide-y divide-line">
                    <thead class="bg-surface-2">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-fg-muted uppercase tracking-wider">{{ 'payment_source.index.col_name'|trans }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-fg-muted uppercase tracking-wider">{{ 'payment_source.index.col_subscriptions'|trans }}</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-fg-muted uppercase tracking-wider">{{ 'payment_source.index.col_actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="bg-surface divide-y divide-line">
                        {% for payment_source in payment_sources %}
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="flex items-center gap-2">
                                        {{ include('payment_source/_badge.html.twig', {payment_source: payment_source}) }}
                                        {{ payment_source.name }}
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">{{ payment_source.subscriptions|length }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <a href="{{ path('payment_source_show', {id: payment_source.id}) }}" class="text-brand hover:text-brand-strong mr-3">{{ 'common.action.view'|trans }}</a>
                                    <a href="{{ path('payment_source_edit', {id: payment_source.id}) }}" class="text-brand hover:text-brand-strong">{{ 'common.action.edit'|trans }}</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="empty-state bg-surface-2 border border-line rounded-lg px-6 py-12 text-center">
                <p class="text-fg-muted text-lg">{{ 'payment_source.empty.title'|trans }}</p>
                <p class="text-fg-muted mt-2">{{ 'payment_source.empty.subtitle'|trans }}</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
