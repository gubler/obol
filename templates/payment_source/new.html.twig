{% extends 'base.html.twig' %}

{% block title %}{{ 'payment_source.new.title'|trans }}{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="mb-6">
            <a href="{{ path('payment_source_index') }}" class="text-brand hover:text-brand-strong mb-4 inline-block">&larr; {{ 'payment_source.new.back'|trans }}</a>
            <h1 class="text-3xl font-bold">{{ 'payment_source.new.heading'|trans }}</h1>
        </div>

        <div class="bg-surface shadow-md rounded p-6 max-w-2xl">
            {{ form_start(form, {attr: {class: 'space-y-6'}}) }}

            {{ include('payment_source/_form.html.twig', {form: form}) }}

            <div class="flex justify-end space-x-3">
                <a href="{{ path('payment_source_index') }}" class="bg-surface-2 hover:bg-line text-fg font-bold py-2 px-4 rounded">
                    {{ 'common.action.cancel'|trans }}
                </a>
                <button type="submit" class="bg-brand hover:bg-brand-strong text-on-brand font-bold py-2 px-4 rounded">
                    {{ 'common.action.save'|trans }}
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
