{% extends 'base.html.twig' %}

{% block title %}{{ payment_source.name }}{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="mb-6">
            <a href="{{ path('payment_source_index') }}" class="text-brand hover:text-brand-strong mb-4 inline-block">&larr; {{ 'payment_source.show.back'|trans }}</a>
            <h1 class="flex items-center gap-3 text-3xl font-bold">
                {{ include('payment_source/_badge.html.twig', {payment_source: payment_source}) }}
                {{ payment_source.name }}
            </h1>
        </div>

        {% for message in app.flashes('success') %}
            <div class="flash-success bg-success-surface border border-success text-success px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="flash-error bg-danger-surface border border-danger text-danger px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}

        <div class="bg-surface shadow-md rounded p-6 mb-6">
            <div class="flex justify-between items-center">
                <h2 class="text-xl font-semibold">{{ 'payment_source.show.details_heading'|trans }}</h2>
                <div class="space-x-2">
                    <a href="{{ path('payment_source_edit', {id: payment_source.id}) }}" class="bg-brand hover:bg-brand-strong text-on-brand font-bold py-2 px-4 rounded">
                        {{ 'common.action.edit'|trans }}
                    </a>
                    <form action="{{ path('payment_source_delete', {id: payment_source.id}) }}" method="POST" class="inline-block" data-turbo-confirm="{{ 'payment_source.show.delete_confirm'|trans }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                        <button type="submit" class="bg-danger text-white hover:opacity-90 font-bold py-2 px-4 rounded">
                            {{ 'common.action.delete'|trans }}
                        </button>
                    </form>
                </div>
            </div>

            {% if payment_source.comment %}
                <p class="text-fg-muted mt-4 whitespace-pre-line">{{ payment_source.comment }}</p>
            {% endif %}
        </div>

        <div class="bg-surface shadow-md rounded p-6">
            <h2 class="text-xl font-semibold mb-4">{{ 'payment_source.show.subscriptions_heading'|trans }}</h2>

            {% if payment_source.subscriptions|length > 0 %}
                <ul class="divide-y divide-line">
                    {% for subscription in payment_source.subscriptions %}
                        <li class="py-3">
                            <div class="flex justify-between items-center">
                                <span class="text-fg">{{ subscription.name }}</span>
                                <span class="text-fg-muted">{{ subscription.cost.format() }} / {{ 'subscription.cadence'|trans({count: subscription.paymentPeriodCount, period: subscription.paymentPeriod.value}) }}</span>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-fg-muted">{{ 'payment_source.show.no_subscriptions'|trans }}</p>
            {% endif %}

            {% if reassign_form is not null %}
                {{ form_start(reassign_form, {attr: {class: 'mt-6 border-t border-line pt-4'}}) }}
                    {{ form_label(reassign_form.target, null, {label_attr: {class: 'block text-sm font-medium text-fg mb-2'}}) }}
                    <div class="flex items-center gap-2">
                        {{ form_widget(reassign_form.target, {attr: {class: 'rounded-md border-line shadow-sm focus:border-brand focus:ring-brand sm:text-sm'}}) }}
                        <button type="submit" class="bg-brand hover:bg-brand-strong text-on-brand font-bold py-2 px-4 rounded">
                            {{ 'payment_source.show.move_all_button'|trans }}
                        </button>
                    </div>
                {{ form_end(reassign_form) }}
            {% endif %}
        </div>
    </div>
{% endblock %}
