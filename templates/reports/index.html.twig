{% extends 'base.html.twig' %}

{% block title %}{{ 'report.heading'|trans }}{% endblock %}

{% block header %}
    <h1 class="text-3xl font-bold tracking-tight text-header-fg">{{ 'report.heading'|trans }}</h1>
{% endblock %}

{% block body %}
    {% set toggle_link = 'rounded-md px-3 py-2 text-sm font-medium transition' %}
    {% set toggle_on = 'bg-brand text-on-brand' %}
    {% set toggle_off = 'text-fg-muted hover:bg-surface-2' %}

    <section class="reports-composition">
        <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2 border-b border-line pb-3">
            <h2 class="text-lg font-semibold text-fg">{{ 'report.composition.by_category'|trans }}</h2>
            <div class="report-total text-2xl font-semibold text-fg">
                {{ include('components/money_disclosure.html.twig', {
                    amount: composition.total.converted,
                    label: 'subscription.totals.per_month'|trans,
                    asOf: composition.asOf,
                    breakdown: composition.total.breakdown,
                    approximate: composition.total.isApproximate,
                }) }}
            </div>
        </div>

        {% if composition.slices is empty %}
            <div class="empty-state rounded-lg border border-line bg-surface-2 px-6 py-12 text-center">
                <p class="text-lg text-fg-muted">{{ 'report.composition.empty_title'|trans }}</p>
                <p class="mt-2 text-fg-muted">{{ 'report.composition.empty_hint'|trans }}</p>
            </div>
        {% else %}
            <div class="grid items-center gap-8 md:grid-cols-2">
                {{ include('reports/_pie.html.twig', {chart: chart}) }}

                <ul class="report-category-list divide-y divide-line">
                    {% for slice in composition.slices %}
                        <li>
                            <a href="{{ slice.uncategorized ? path('reports_uncategorized') : path('reports_category', {id: slice.id}) }}"
                               class="report-category-link flex items-center justify-between gap-4 py-2 text-fg hover:bg-surface-2">
                                <span class="flex items-center gap-2">
                                    {{ include('category/_badge.html.twig', {color: slice.color, icon: slice.icon}) }}
                                    <span class="report-category font-medium">{{ slice.label }}</span>
                                </span>
                                <span class="report-category-amount text-sm text-fg-muted">
                                    {{ include('components/money_disclosure.html.twig', {amount: slice.converted, label: 'subscription.totals.per_month'|trans, approximate: slice.isApproximate}) }}
                                </span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </section>

    <section class="obligation-trend mt-10">
        <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2 border-b border-line pb-3">
            <h2 class="text-lg font-semibold text-fg">{{ 'report.trend.heading'|trans }}</h2>
            <div class="inline-flex rounded-md bg-surface-2 p-1">
                {% for option in trendOptions %}
                    <a href="{{ path('reports_index', {trend: option.value}) }}"
                       class="{{ toggle_link }} {{ option == trendPeriod ? toggle_on : toggle_off }}"
                       {%- if option == trendPeriod %} aria-current="page"{% endif %}>{{ option.label|trans }}</a>
                {% endfor %}
            </div>
        </div>
        {{ include('reports/_line.html.twig', {chart: trendChart}) }}
    </section>
{% endblock %}
