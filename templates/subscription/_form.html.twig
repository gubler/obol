{# ABOUTME: Shared field layout for the subscription create/edit forms. #}
{# ABOUTME: Renders the cycle as one inline "Every N period" control and cost as the currency dropdown leading the amount. #}

{{ form_errors(form) }}

{% if form.category is defined %}
    {{ form_row(form.category) }}
{% endif %}

{% if form.paymentSource is defined %}
    {{ form_row(form.paymentSource) }}
{% endif %}

{{ form_row(form.name) }}

{# A past renewal is allowed (it switches the subscription to manual generation); warn softly. #}
<div data-controller="past-date-warning">
    {{ form_row(form.nextRenewal, {attr: {
        'data-past-date-warning-target': 'input',
        'data-action': 'input->past-date-warning#check',
    }}) }}
    <p class="past-date-warning mt-1 text-sm text-warning" data-past-date-warning-target="message" hidden>
        {{ 'subscription.form.past_date_warning'|trans }}
    </p>
</div>

{# Cycle: paymentPeriodCount + paymentPeriod read as one sentence, "Every N period(s)". #}
<div data-controller="billing-cycle">
    <span class="block text-fg">{{ 'subscription.form.billing_cycle'|trans }}</span>
    <div class="mt-1 flex items-center gap-2">
        <span class="text-fg">{{ 'subscription.form.billing_cycle_every'|trans }}</span>
        {{ form_widget(form.paymentPeriodCount, {attr: {
            class: 'w-20',
            min: 1,
            'data-billing-cycle-target': 'count',
            'data-action': 'input->billing-cycle#update',
        }}) }}
        {{ form_widget(form.paymentPeriod, {attr: {
            class: 'w-auto',
            'data-billing-cycle-target': 'period',
        }}) }}
    </div>
    {{ form_errors(form.paymentPeriodCount) }}
    {{ form_errors(form.paymentPeriod) }}
</div>

{# Cost: the currency dropdown leads the amount as one input group; the dropdown shows "<symbol> <ISO>". #}
<div>
    {{ form_label(form.cost) }}
    <div class="cost-field mt-1 flex border border-line bg-surface-2 focus-within:border-brand focus-within:ring-1 focus-within:ring-brand">
        {# A divider (border-r) separates the dropdown from the amount; the @tailwindcss/forms plugin
           supplies the select's own chevron, so we add none of our own. #}
        {{ form_widget(form.currency, {attr: {
            class: 'shrink-0 border-0 border-r border-line bg-transparent py-2 pr-8 pl-3 text-fg-muted focus:border-line focus:outline-none focus:ring-0',
        }}) }}
        {{ form_widget(form.cost, {attr: {
            class: 'block min-w-0 grow border-0 bg-transparent px-3 py-2 text-fg focus:outline-none focus:ring-0',
        }}) }}
    </div>
    {{ form_errors(form.cost) }}
    {{ form_errors(form.currency) }}
</div>

{# Everything still unrendered (description, link, color, restart, CSRF token), in field order. #}
{{ form_rest(form) }}
