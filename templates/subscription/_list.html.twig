{# Table of subscriptions. Expects: subscriptions (iterable of Subscription). #}
<div class="overflow-hidden rounded border border-gray-200">
    <table class="subscription-list min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
                <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Cost / month</th>
                <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Cost / period</th>
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Next payment</th>
                <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
            {% for subscription in subscriptions %}
                <tr>
                    <td class="whitespace-nowrap px-6 py-4">
                        {{ subscription.name }}
                        {% if subscription.archived %}
                            <span class="archived-badge ml-2 inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800">Archived</span>
                        {% endif %}
                        {% if not subscription.generatesPaymentsAutomatically %}
                            <span class="manual-payments-badge ml-2 inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800" title="Automatic payment generation is paused">Manual</span>
                        {% endif %}
                    </td>
                    <td class="whitespace-nowrap px-6 py-4 text-right text-gray-900">${{ (subscription.monthlyCost / 100)|number_format(2) }}</td>
                    <td class="whitespace-nowrap px-6 py-4 text-right text-gray-900">
                        ${{ (subscription.cost / 100)|number_format(2) }} / {{ subscription.paymentPeriodCount > 1 ? subscription.paymentPeriodCount ~ ' ' : '' }}{{ subscription.paymentPeriod.value }}{{ subscription.paymentPeriodCount > 1 ? 's' : '' }}
                    </td>
                    <td class="whitespace-nowrap px-6 py-4 text-gray-900">{{ subscription.nextRenewal|date('M j, Y') }}</td>
                    <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                        <a href="{{ path('subscription_show', {id: subscription.id}) }}" class="mr-3 text-blue-600 hover:text-blue-900">View</a>
                        <a href="{{ path('subscription_edit', {id: subscription.id}) }}" class="text-indigo-600 hover:text-indigo-900">Edit</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
