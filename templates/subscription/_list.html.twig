{# Table of subscriptions. Expects: subscriptions (iterable of Subscription). #}
<div class="overflow-hidden rounded border border-line">
    <table class="subscription-list min-w-full divide-y divide-line">
        <thead class="bg-surface-2">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-fg-muted">Name</th>
                <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-fg-muted">Cost / month</th>
                <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-fg-muted">Cost / period</th>
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-fg-muted">Next payment</th>
                <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-fg-muted">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-line bg-surface">
            {% for subscription in subscriptions %}
                <tr>
                    <td class="whitespace-nowrap px-6 py-4">
                        {{ subscription.name }}
                        {% if subscription.archived %}
                            <span class="archived-badge ml-2 inline-flex items-center rounded-full bg-surface-2 px-2.5 py-0.5 text-xs font-medium text-fg-muted">Archived</span>
                        {% endif %}
                        {% if not subscription.generatesPaymentsAutomatically %}
                            <span class="manual-payments-badge ml-2 inline-flex items-center rounded-full bg-warning-surface px-2.5 py-0.5 text-xs font-medium text-warning" title="Automatic payment generation is paused">Manual</span>
                        {% endif %}
                    </td>
                    <td class="whitespace-nowrap px-6 py-4 text-right text-fg">{{ subscription.monthlyCost.format() }}</td>
                    <td class="whitespace-nowrap px-6 py-4 text-right text-fg">
                        {{ subscription.cost.format() }} / {{ subscription.paymentPeriodCount > 1 ? subscription.paymentPeriodCount ~ ' ' : '' }}{{ subscription.paymentPeriod.value }}{{ subscription.paymentPeriodCount > 1 ? 's' : '' }}
                    </td>
                    <td class="whitespace-nowrap px-6 py-4 text-fg">{{ subscription.nextRenewal|date('M j, Y') }}</td>
                    <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                        <a href="{{ path('subscription_show', {id: subscription.id}) }}" class="mr-3 text-brand hover:text-brand-strong">View</a>
                        <a href="{{ path('subscription_edit', {id: subscription.id}) }}" class="text-brand hover:text-brand-strong">Edit</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
