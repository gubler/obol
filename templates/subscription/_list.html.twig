{# Table of subscriptions. Expects: subscriptions (iterable of Subscription). #}
<div class="overflow-x-auto rounded border border-line">
    <table class="subscription-list min-w-full divide-y divide-line">
        <thead class="bg-surface-2">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-fg-muted">{{ 'subscription.list.name'|trans }}</th>
                <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-fg-muted">{{ 'subscription.list.cost_per_month'|trans }}</th>
                <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-fg-muted">{{ 'subscription.list.cost_per_period'|trans }}</th>
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-fg-muted">{{ 'subscription.list.next_payment'|trans }}</th>
                <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-fg-muted">{{ 'subscription.list.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-line bg-surface">
            {% for subscription in subscriptions %}
                <tr>
                    <td class="whitespace-nowrap px-6 py-4">
                        {{ subscription.name }}
                        {% if subscription.archived %}
                            <span class="archived-badge ml-2 inline-flex items-center rounded-full bg-surface-2 px-2.5 py-0.5 text-xs font-medium text-fg-muted">{{ 'subscription.badge.archived'|trans }}</span>
                        {% endif %}
                        {% if not subscription.generatesPaymentsAutomatically %}
                            <span class="manual-payments-badge ml-2 inline-flex items-center rounded-full bg-warning-surface px-2.5 py-0.5 text-xs font-medium text-warning" title="{{ 'subscription.badge.manual_paused'|trans }}">{{ 'subscription.badge.manual'|trans }}</span>
                        {% endif %}
                    </td>
                    <td class="whitespace-nowrap px-6 py-4 text-right text-fg">{{ subscription.monthlyCost|money }}</td>
                    <td class="whitespace-nowrap px-6 py-4 text-right text-fg">
                        {{ subscription.cost|money }} / {{ 'subscription.cadence'|trans({count: subscription.paymentPeriodCount, period: subscription.paymentPeriod.value}) }}
                    </td>
                    <td class="whitespace-nowrap px-6 py-4 text-fg">{{ subscription.nextRenewal|user_date }}</td>
                    <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                        <a href="{{ path('subscription_show', {id: subscription.id}) }}" class="mr-3 text-brand hover:text-brand-strong">{{ 'common.action.view'|trans }}</a>
                        <a href="{{ path('subscription_edit', {id: subscription.id}) }}" class="text-brand hover:text-brand-strong">{{ 'common.action.edit'|trans }}</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
