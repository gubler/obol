{# A single subscription tile. Expects: subscription (Subscription).
   Optional: demo (bool) - renders a non-navigating tile for the tour's sample, which has no detail page. #}
{% set demo = demo|default(false) %}
{% set tile_classes = 'subscription-tile ' ~ subscription.color.gradientClasses() ~ ' relative flex aspect-[5/3] flex-col justify-between overflow-hidden rounded-xl p-4 text-white shadow-sm transition hover:brightness-110' %}
{% set tile_body %}
    <div class="flex items-start justify-between gap-2">
        <div class="text-2xl font-bold leading-none">
            {% if subscription.logo %}
                <img src="{{ subscription.logo }}" alt="" class="size-8 object-contain">
            {% endif %}
        </div>
        <div class="text-xl font-bold leading-none"
             title="{{ 'subscription.tile_period'|trans({count: subscription.paymentPeriodCount, period: subscription.paymentPeriod.value}) }}">
            {{ subscription.cost|money }}
        </div>
    </div>
    <div>
        <div class="font-semibold leading-tight">{{ subscription.name }}</div>
        <div class="mt-0.5 text-sm text-white/80">{{ subscription.nextRenewal|renewal_label(subscription.owner) }}</div>
        {% if subscription.archived %}
            <span class="archived-badge mt-2 inline-flex items-center rounded-full bg-black/30 px-2 py-0.5 text-xs font-medium text-white">{{ 'subscription.badge.archived'|trans }}</span>
        {% endif %}
        {% if not subscription.generatesPaymentsAutomatically %}
            <span class="manual-payments-badge mt-2 inline-flex items-center gap-1 rounded-full bg-black/30 px-2 py-0.5 text-xs font-medium text-white" title="{{ 'subscription.badge.manual_paused'|trans }}">
                <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4a1 1 0 0 1 1 1v10a1 1 0 1 1-2 0V5a1 1 0 0 1 1-1Zm6 0a1 1 0 0 1 1 1v10a1 1 0 1 1-2 0V5a1 1 0 0 1 1-1Z"/></svg>
                {{ 'subscription.badge.manual'|trans }}
            </span>
        {% endif %}
    </div>
{% endset %}
{% if demo %}
    <div class="{{ tile_classes }}" data-tour="tile">{{ tile_body }}</div>
{% else %}
    <a href="{{ path('subscription_show', {id: subscription.id}) }}" class="{{ tile_classes }}">{{ tile_body }}</a>
{% endif %}
