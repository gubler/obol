{# Grid of subscription tiles. Expects: subscriptions (iterable of Subscription). Optional: demo (bool). #}
<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
    {% for subscription in subscriptions %}
        {{ include('subscription/_tile.html.twig', {subscription: subscription, demo: demo|default(false)}) }}
    {% endfor %}
</div>
