{% extends 'base.html.twig' %}

{% block title %}{{ 'subscription.edit.title'|trans }}{% endblock %}

{% form_theme form 'form/_subscription_form_theme.html.twig' %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="mb-6">
            <a href="{{ path('subscription_show', {id: subscription.id}) }}" class="text-brand hover:text-brand-strong mb-4 inline-block">&larr; {{ 'subscription.edit.back'|trans }}</a>
            <h1 class="text-3xl font-bold">{{ 'subscription.edit.heading'|trans }}</h1>
        </div>

        <div class="bg-surface shadow-md rounded p-6 max-w-2xl">
            {{ form_start(form, {attr: {class: 'space-y-6'}}) }}

            {% if form.restartPaymentGeneration is defined %}
                <div class="rounded border border-warning bg-warning-surface p-3 text-sm text-warning">
                    {{ 'subscription.edit.restart_notice'|trans }}
                </div>
            {% endif %}

            {{ include('subscription/_form.html.twig', {form: form}) }}

            <div class="flex justify-end space-x-3">
                <a href="{{ path('subscription_show', {id: subscription.id}) }}" class="bg-surface-2 hover:bg-line text-fg font-bold py-2 px-4 rounded">
                    {{ 'common.action.cancel'|trans }}
                </a>
                <button type="submit" class="bg-brand hover:bg-brand-strong text-on-brand font-bold py-2 px-4 rounded">
                    {{ 'common.action.save'|trans }}
                </button>
            </div>

            {{ form_end(form) }}
        </div>

        <div class="bg-surface shadow-md rounded p-6 max-w-2xl mt-6">
            <h2 class="text-lg font-semibold text-fg">{{ 'subscription.edit.actions_heading'|trans }}</h2>
            <p class="mt-1 mb-4 text-sm text-fg-muted">{{ 'subscription.edit.actions_intro'|trans }}</p>
            <div class="flex flex-wrap gap-3">
                {% if subscription.archived %}
                    <form action="{{ path('subscription_unarchive', {id: subscription.id}) }}" method="POST">
                        <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                        <button type="submit" class="bg-surface-2 text-fg hover:bg-line font-bold py-2 px-4 rounded">
                            {{ 'common.action.unarchive'|trans }}
                        </button>
                    </form>
                {% else %}
                    <form action="{{ path('subscription_archive', {id: subscription.id}) }}" method="POST" data-turbo-confirm="{{ 'subscription.show.archive_confirm'|trans }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                        <button type="submit" class="bg-surface-2 text-fg hover:bg-line font-bold py-2 px-4 rounded">
                            {{ 'common.action.archive'|trans }}
                        </button>
                    </form>
                {% endif %}
                <form action="{{ path('subscription_delete', {id: subscription.id}) }}" method="POST" data-turbo-confirm="{{ 'subscription.show.delete_confirm'|trans }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                    <button type="submit" class="bg-danger text-white hover:opacity-90 font-bold py-2 px-4 rounded">
                        {{ 'common.action.delete'|trans }}
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
