{% extends 'base.html.twig' %}

{% block title %}Edit Subscription{% endblock %}

{% form_theme form 'form/_subscription_form_theme.html.twig' %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="mb-6">
            <a href="{{ path('subscription_show', {id: subscription.id}) }}" class="text-blue-600 hover:text-blue-900 mb-4 inline-block">&larr; Back to Subscription</a>
            <h1 class="text-3xl font-bold">Edit Subscription</h1>
        </div>

        <div class="bg-white shadow-md rounded p-6 max-w-2xl">
            {{ form_start(form, {attr: {class: 'space-y-6'}}) }}

            {% if form.restartPaymentGeneration is defined %}
                <div class="rounded border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">
                    Automatic payment generation is paused for this subscription. To resume it, set the
                    Next Renewal Date to a future date and check &ldquo;Restart automatic payments?&rdquo; below.
                </div>
            {% endif %}

            {{ form_widget(form) }}

            <div class="flex justify-end space-x-3">
                <a href="{{ path('subscription_show', {id: subscription.id}) }}" class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded">
                    Cancel
                </a>
                <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                    Save
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
