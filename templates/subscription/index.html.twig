{% extends 'base.html.twig' %}

{% block title %}Obol{% endblock %}

{% block header %}
    <div class="flex justify-between items-center">
        <h1 class="text-3xl font-bold tracking-tight text-white">
            Subscriptions
        </h1>
        <a href="{{ path('subscription_new') }}" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
            New subscription
        </a>
    </div>
{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="flash-success bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            {{ message }}
        </div>
    {% endfor %}

    {% set subscription_count = 0 %}
    {% for group in groups %}
        {% set subscription_count = subscription_count + group.subscriptions|length %}
    {% endfor %}

    {% if subscription_count == 0 %}
        <div class="empty-state bg-gray-100 border border-gray-300 rounded-lg px-6 py-12 text-center">
            <p class="text-gray-600 text-lg">No subscriptions found</p>
            <p class="text-gray-500 mt-2">Get started by creating your first subscription</p>
        </div>
    {% else %}
        {% set toggle_link = 'rounded-md px-3 py-2 text-sm font-medium transition' %}
        {% set toggle_on = 'bg-gray-800 text-white' %}
        {% set toggle_off = 'bg-gray-100 text-gray-700 hover:bg-gray-200' %}

        <div class="mb-6 flex flex-wrap items-center gap-2">
            <div class="inline-flex rounded-md bg-gray-100 p-1">
                <a href="{{ path('subscription_index', {view: 'tiles', group: grouped ? '1' : '0', archived: includeArchived ? '1' : '0'}) }}"
                   class="{{ toggle_link }} {{ view == 'tiles' ? toggle_on : toggle_off }}">Tiles</a>
                <a href="{{ path('subscription_index', {view: 'list', group: grouped ? '1' : '0', archived: includeArchived ? '1' : '0'}) }}"
                   class="{{ toggle_link }} {{ view == 'list' ? toggle_on : toggle_off }}">List</a>
            </div>

            <a href="{{ path('subscription_index', {view: view, group: grouped ? '0' : '1', archived: includeArchived ? '1' : '0'}) }}"
               class="{{ toggle_link }} {{ grouped ? toggle_on : toggle_off }}">{{ grouped ? 'Grouped' : 'Group by category' }}</a>

            <a href="{{ path('subscription_index', {view: view, group: grouped ? '1' : '0', archived: includeArchived ? '0' : '1'}) }}"
               class="{{ toggle_link }} {{ includeArchived ? toggle_on : toggle_off }}">{{ includeArchived ? 'Showing archived' : 'Show archived' }}</a>
        </div>

        {% if grouped %}
            {% for group in groups %}
                <section class="category-group mb-8">
                    <h2 class="category-header mb-3 flex items-baseline justify-between border-b border-gray-200 pb-2">
                        <span class="text-lg font-semibold text-gray-900">{{ group.category.name }}</span>
                        <span class="flex items-baseline gap-3 text-sm font-medium text-gray-500">
                            {% if group.savingsTotal > 0 %}
                                <span class="category-savings-total">${{ (group.savingsTotal / 100)|number_format(2) }} set aside</span>
                            {% endif %}
                            <span class="category-monthly-total">${{ (group.monthlyTotal / 100)|number_format(2) }} / mo</span>
                        </span>
                    </h2>
                    {% if view == 'tiles' %}
                        {{ include('subscription/_tiles.html.twig', {subscriptions: group.subscriptions}) }}
                    {% else %}
                        {{ include('subscription/_list.html.twig', {subscriptions: group.subscriptions}) }}
                    {% endif %}
                </section>
            {% endfor %}
        {% else %}
            {% set all_subscriptions = [] %}
            {% for group in groups %}
                {% set all_subscriptions = all_subscriptions|merge(group.subscriptions) %}
            {% endfor %}
            {% set all_subscriptions = all_subscriptions|sort((a, b) => a.name|lower <=> b.name|lower) %}
            {% if view == 'tiles' %}
                {{ include('subscription/_tiles.html.twig', {subscriptions: all_subscriptions}) }}
            {% else %}
                {{ include('subscription/_list.html.twig', {subscriptions: all_subscriptions}) }}
            {% endif %}
        {% endif %}
    {% endif %}
{% endblock %}
