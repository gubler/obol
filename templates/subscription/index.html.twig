{% extends 'base.html.twig' %}

{% block title %}Obol{% endblock %}

{% block header %}
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <h1 class="text-3xl font-bold tracking-tight text-header-fg">
            {{ 'subscription.index.heading'|trans }}
        </h1>
        <a href="{{ path('subscription_new') }}" data-tour="add" class="self-start bg-brand hover:bg-brand-strong text-on-brand font-bold py-2 px-4 rounded sm:self-auto">
            {{ 'subscription.index.new'|trans }}
        </a>
    </div>
{% endblock %}

{% block body %}
    {% set demo = demo|default(false) %}

    {% if demo %}
        {% set tour_labels = {
            subscriptions: {title: 'tour.step.subscriptions.title'|trans, body: 'tour.step.subscriptions.body'|trans},
            add: {title: 'tour.step.add.title'|trans, body: 'tour.step.add.body'|trans},
            totals: {title: 'tour.step.totals.title'|trans, body: 'tour.step.totals.body'|trans},
            tile: {title: 'tour.step.tile.title'|trans, body: 'tour.step.tile.body'|trans},
            categories: {title: 'tour.step.categories.title'|trans, body: 'tour.step.categories.body'|trans},
            payment_sources: {title: 'tour.step.payment_sources.title'|trans, body: 'tour.step.payment_sources.body'|trans},
            reports: {title: 'tour.step.reports.title'|trans, body: 'tour.step.reports.body'|trans},
            account: {title: 'tour.step.account.title'|trans, body: 'tour.step.account.body'|trans},
            theme: {title: 'tour.step.theme.title'|trans, body: 'tour.step.theme.body'|trans},
        } %}
        <div class="tour-sample-notice mb-6 rounded-lg border border-info bg-info-surface px-4 py-3"
             data-controller="tour"
             data-tour-autostart-value="true"
             data-tour-return-url-value="{{ path('subscription_index') }}"
             data-tour-labels-value="{{ tour_labels|json_encode }}">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <p class="font-semibold text-fg">{{ 'tour.sample.heading'|trans }}</p>
                    <p class="mt-1 text-sm text-fg-muted">{{ 'tour.sample.body'|trans }}</p>
                </div>
                <a href="{{ path('subscription_index') }}" class="shrink-0 rounded px-3 py-2 text-sm font-medium text-fg-muted hover:bg-surface-2">{{ 'tour.sample.exit'|trans }}</a>
            </div>
        </div>
    {% endif %}

    {% if app.request.query.get('welcome') %}
        <div class="tour-welcome mb-6 rounded-lg border border-info bg-info-surface px-4 py-3">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <p class="font-semibold text-fg">{{ 'tour.welcome.heading'|trans }}</p>
                    <p class="mt-1 text-sm text-fg-muted">{{ 'tour.welcome.body'|trans }}</p>
                </div>
                <div class="flex shrink-0 gap-2">
                    <a href="{{ path('subscription_tour') }}" class="rounded bg-brand px-3 py-2 text-sm font-bold text-on-brand hover:bg-brand-strong">{{ 'tour.welcome.start'|trans }}</a>
                    <a href="{{ path('subscription_index') }}" class="rounded px-3 py-2 text-sm font-medium text-fg-muted hover:bg-surface-2">{{ 'tour.welcome.dismiss'|trans }}</a>
                </div>
            </div>
        </div>
    {% endif %}

    {{ include('components/_flashes.html.twig', with_context: false) }}

    {% set subscription_count = listing.subscriptions|length %}

    {% if subscription_count == 0 %}
        <div class="empty-state bg-surface-2 border border-line rounded-lg px-6 py-12 text-center">
            <p class="text-fg-muted text-lg">{{ 'subscription.index.empty.title'|trans }}</p>
            <p class="text-fg-muted mt-2">{{ 'subscription.index.empty.subtitle'|trans }}</p>
            <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <a href="{{ path('subscription_new') }}" class="rounded bg-brand px-4 py-2 font-bold text-on-brand hover:bg-brand-strong">{{ 'subscription.index.empty.add'|trans }}</a>
                <a href="{{ path('subscription_tour') }}" class="font-medium text-brand hover:text-brand-strong">{{ 'subscription.index.empty.tour'|trans }}</a>
            </div>
        </div>
    {% else %}
        {% set toggle_link = 'rounded-md px-3 py-2 text-sm font-medium transition' %}
        {% set toggle_on = 'bg-brand text-on-brand' %}
        {% set toggle_off = 'text-fg-muted hover:bg-surface-2' %}

        {% set base_params = {view: view, group: grouped ? '1' : '0', archived: includeArchived ? '1' : '0', sort: sort.value, capstone: capstoneMode} %}

        <section class="global-totals mb-6 rounded-lg border border-line bg-surface p-4" data-tour="totals">
            <div class="mb-3 inline-flex rounded-md bg-surface-2 p-1">
                <a href="{{ path('subscription_index', base_params|merge({capstone: 'totals'})) }}"
                   class="{{ toggle_link }} {{ capstoneMode == 'totals' ? toggle_on : toggle_off }}">{{ 'subscription.capstone.global_totals'|trans }}</a>
                <a href="{{ path('subscription_index', base_params|merge({capstone: 'remaining'})) }}"
                   class="{{ toggle_link }} {{ capstoneMode == 'remaining' ? toggle_on : toggle_off }}">{{ 'subscription.capstone.remaining'|trans }}</a>
            </div>
            {% if capstoneMode == 'remaining' %}
                {{ include('subscription/_remaining.html.twig', {remaining: capstone}) }}
            {% else %}
                {{ include('subscription/_global_totals.html.twig', {totals: capstone}) }}
            {% endif %}
        </section>

        <div class="mb-6 flex flex-wrap items-center gap-2">
            <div class="inline-flex rounded-md bg-surface-2 p-1">
                <a href="{{ path('subscription_index', base_params|merge({view: 'tiles'})) }}"
                   class="{{ toggle_link }} {{ view == 'tiles' ? toggle_on : toggle_off }}">{{ 'subscription.view.tiles'|trans }}</a>
                <a href="{{ path('subscription_index', base_params|merge({view: 'list'})) }}"
                   class="{{ toggle_link }} {{ view == 'list' ? toggle_on : toggle_off }}">{{ 'subscription.view.list'|trans }}</a>
            </div>

            <a href="{{ path('subscription_index', base_params|merge({group: grouped ? '0' : '1'})) }}"
               class="{{ toggle_link }} {{ grouped ? toggle_on : toggle_off }}">{{ (grouped ? 'subscription.group.grouped' : 'subscription.group.ungrouped')|trans }}</a>

            <a href="{{ path('subscription_index', base_params|merge({archived: includeArchived ? '0' : '1'})) }}"
               class="{{ toggle_link }} {{ includeArchived ? toggle_on : toggle_off }}">{{ (includeArchived ? 'subscription.archived.showing' : 'subscription.archived.show')|trans }}</a>

            <div class="sort-controls inline-flex items-center gap-2">
                <span class="text-sm font-medium text-fg-muted">{{ 'subscription.sort.label'|trans }}</span>
                <div class="inline-flex rounded-md bg-surface-2 p-1">
                    {% for option in sortOptions %}
                        <a href="{{ path('subscription_index', base_params|merge({sort: option.value})) }}"
                           class="{{ toggle_link }} {{ sort == option ? toggle_on : toggle_off }}">{{ option.label|trans }}</a>
                    {% endfor %}
                </div>
            </div>
        </div>

        {% if grouped %}
            {% for group in listing.groups %}
                <section class="category-group mb-8">
                    <h2 class="category-header mb-3 flex items-center justify-between border-b border-line pb-2">
                        <span class="flex items-center gap-2 text-lg font-semibold text-fg">
                            {{ include('category/_badge.html.twig', {category: group.category}) }}
                            {{ group.category ? group.category.name : 'subscription.group.uncategorized'|trans }}
                        </span>
                        <span class="flex items-baseline gap-3 text-sm font-medium text-fg-muted">
                            {% if group.savingsTotal is not null and group.savingsTotal.converted.minorAmount > 0 %}
                                <span class="category-savings-total">
                                    {{ include('components/money_disclosure.html.twig', {
                                        amount: group.savingsTotal.converted,
                                        label: 'subscription.totals.set_aside'|trans,
                                        asOf: group.asOf,
                                        breakdown: group.savingsTotal.breakdown,
                                        approximate: group.savingsTotal.isApproximate,
                                    }) }}
                                </span>
                            {% endif %}
                            <span class="category-monthly-total">
                                {{ include('components/money_disclosure.html.twig', {
                                    amount: group.monthlyTotal.converted,
                                    label: 'subscription.totals.per_month'|trans,
                                    asOf: group.asOf,
                                    breakdown: group.monthlyTotal.breakdown,
                                    approximate: group.monthlyTotal.isApproximate,
                                }) }}
                            </span>
                        </span>
                    </h2>
                    {% if view == 'tiles' %}
                        {{ include('subscription/_tiles.html.twig', {subscriptions: group.subscriptions, demo: demo}) }}
                    {% else %}
                        {{ include('subscription/_list.html.twig', {subscriptions: group.subscriptions}) }}
                    {% endif %}
                </section>
            {% endfor %}
        {% else %}
            {% if view == 'tiles' %}
                {{ include('subscription/_tiles.html.twig', {subscriptions: listing.subscriptions, demo: demo}) }}
            {% else %}
                {{ include('subscription/_list.html.twig', {subscriptions: listing.subscriptions}) }}
            {% endif %}
        {% endif %}
    {% endif %}
{% endblock %}
