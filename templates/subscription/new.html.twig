{% extends 'base.html.twig' %}

{% block title %}{{ 'subscription.new.title'|trans }}{% endblock %}

{% form_theme form 'form/_subscription_form_theme.html.twig' %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="mb-6">
            <a href="{{ path('subscription_index') }}" class="text-brand hover:text-brand-strong mb-4 inline-block">&larr; {{ 'subscription.new.back'|trans }}</a>
            <h1 class="text-3xl font-bold">{{ 'subscription.new.heading'|trans }}</h1>
        </div>

        <div class="bg-surface shadow-md rounded p-6 max-w-2xl">
            {# color-sync (new form only): sync the color swatch to the chosen category's color until
               the user picks a swatch. See assets/controllers/color_sync_controller.js. #}
            {{ form_start(form, {attr: {class: 'space-y-6', 'data-controller': 'color-sync'}}) }}

            {{ include('subscription/_form.html.twig', {form: form}) }}

            <div class="flex justify-end space-x-3">
                <a href="{{ path('subscription_index') }}" class="bg-surface-2 hover:bg-line text-fg font-bold py-2 px-4 rounded">
                    {{ 'common.action.cancel'|trans }}
                </a>
                <button type="submit" class="bg-brand hover:bg-brand-strong text-on-brand font-bold py-2 px-4 rounded">
                    {{ 'common.action.save'|trans }}
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
