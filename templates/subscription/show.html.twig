{% extends 'base.html.twig' %}

{% block title %}{{ subscription.name }}{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="mb-6">
            <a href="{{ path('subscription_index') }}" class="text-brand hover:text-brand-strong mb-4 inline-block">&larr; {{ 'subscription.show.back'|trans }}</a>
            <h1 class="text-3xl font-bold">{{ subscription.name }}</h1>
            {% if not subscription.generatesPaymentsAutomatically %}
                <span class="manual-payments-badge mt-2 inline-flex items-center gap-1 rounded-full bg-warning-surface px-3 py-1 text-sm font-medium text-warning"
                      title="{{ 'subscription.show.manual_hint'|trans }}">
                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4a1 1 0 0 1 1 1v10a1 1 0 1 1-2 0V5a1 1 0 0 1 1-1Zm6 0a1 1 0 0 1 1 1v10a1 1 0 1 1-2 0V5a1 1 0 0 1 1-1Z"/></svg>
                    {{ 'subscription.show.manual_badge'|trans }}
                </span>
            {% endif %}
        </div>

        {% for message in app.flashes('success') %}
            <div class="flash-success bg-success-surface border border-success text-success px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="flash-error bg-danger-surface border border-danger text-danger px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}

        <div class="bg-surface shadow-md rounded p-6 mb-6">
            <div class="flex justify-between items-center">
                <h2 class="text-xl font-semibold">{{ 'subscription.show.details_heading'|trans }}</h2>
                <div class="space-x-2">
                    <a href="{{ path('subscription_edit', {id: subscription.id}) }}" class="bg-brand hover:bg-brand-strong text-on-brand font-bold py-2 px-4 rounded">
                        {{ 'common.action.edit'|trans }}
                    </a>
                    {% if subscription.archived %}
                        <form action="{{ path('subscription_unarchive', {id: subscription.id}) }}" method="POST" class="inline-block">
                            <button type="submit" class="bg-surface-2 text-fg hover:bg-line font-bold py-2 px-4 rounded">
                                {{ 'common.action.unarchive'|trans }}
                            </button>
                        </form>
                    {% else %}
                        <form action="{{ path('subscription_archive', {id: subscription.id}) }}" method="POST" class="inline-block" data-turbo-confirm="{{ 'subscription.show.archive_confirm'|trans }}">
                            <button type="submit" class="bg-surface-2 text-fg hover:bg-line font-bold py-2 px-4 rounded">
                                {{ 'common.action.archive'|trans }}
                            </button>
                        </form>
                    {% endif %}
                    <form action="{{ path('subscription_delete', {id: subscription.id}) }}" method="POST" class="inline-block" data-turbo-confirm="{{ 'subscription.show.delete_confirm'|trans }}">
                        <button type="submit" class="bg-danger text-white hover:opacity-90 font-bold py-2 px-4 rounded">
                            {{ 'common.action.delete'|trans }}
                        </button>
                    </form>
                </div>
            </div>

            <dl class="mt-4 space-y-2">
                <div>
                    <dt class="text-sm font-medium text-fg-muted">{{ 'subscription.show.category'|trans }}</dt>
                    <dd class="text-lg text-fg">{{ subscription.category ? subscription.category.name : 'subscription.group.uncategorized'|trans }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-fg-muted">{{ 'subscription.show.payment_source'|trans }}</dt>
                    <dd class="text-lg text-fg">{{ subscription.paymentSource ? subscription.paymentSource.name : 'subscription.group.unassigned'|trans }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-fg-muted">{{ 'subscription.show.cost'|trans }}</dt>
                    <dd class="text-lg text-fg">{{ subscription.cost.format() }} / {{ 'subscription.cadence'|trans({count: subscription.paymentPeriodCount, period: subscription.paymentPeriod.value}) }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-fg-muted">{{ 'subscription.show.next_renewal'|trans }}</dt>
                    <dd class="text-lg text-fg">
                        {{ subscription.nextRenewal|user_date }}
                        {% if subscription.isNextRenewalAdjusted() %}
                            <span class="renewal-adjusted-alert ml-1 inline-flex items-center align-middle text-fg-muted"
                                  title="{{ 'subscription.show.renewal_adjusted'|trans({'%day%': subscription.renewalDay, '%adjusted%': subscription.nextRenewal.day}) }}">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
                                <span class="sr-only">{{ 'subscription.show.renewal_adjusted'|trans({'%day%': subscription.renewalDay, '%adjusted%': subscription.nextRenewal.day}) }}</span>
                            </span>
                        {% endif %}
                    </dd>
                </div>
                {% if savingsTarget is not null %}
                <div class="subscription-savings-target">
                    <dt class="text-sm font-medium text-fg-muted">{{ 'subscription.show.savings_target'|trans }}</dt>
                    <dd class="text-lg text-fg">{{ savingsTarget.format() }}</dd>
                </div>
                {% endif %}
                {% if subscription.description %}
                <div>
                    <dt class="text-sm font-medium text-fg-muted">{{ 'subscription.show.description'|trans }}</dt>
                    <dd class="text-lg text-fg">{{ subscription.description }}</dd>
                </div>
                {% endif %}
                {% if subscription.link %}
                <div>
                    <dt class="text-sm font-medium text-fg-muted">{{ 'subscription.show.link'|trans }}</dt>
                    <dd class="text-lg text-fg"><a href="{{ subscription.link }}" target="_blank" class="text-brand hover:text-brand-strong">{{ subscription.link }}</a></dd>
                </div>
                {% endif %}
            </dl>
        </div>

        <div class="payments-section bg-surface shadow-md rounded p-6 mb-6">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-semibold">{{ 'payment.show.heading'|trans }}</h2>
                <a href="{{ path('payment_new', {subscriptionId: subscription.id}) }}" class="bg-brand hover:bg-brand-strong text-on-brand font-bold py-2 px-4 rounded">
                    {{ 'payment.action.add'|trans }}
                </a>
            </div>

            {% if subscription.payments|length > 0 %}
                <ul class="divide-y divide-line">
                    {% for payment in subscription.payments %}
                        <li class="py-3">
                            <div class="flex justify-between items-center">
                                <div>
                                    <span class="text-fg">{{ payment.paidDate|user_date }}</span>
                                    <span class="ml-2 text-xs text-fg-muted">{{ payment.type.label|trans }}</span>
                                </div>
                                <div class="flex items-center space-x-3">
                                    <span class="text-fg-muted">{{ payment.amount.format() }}</span>
                                    {% if payment.type.value == 'generated' %}
                                        <form action="{{ path('payment_validate', {id: payment.id}) }}" method="POST" class="payment-validate-form inline-block">
                                            <button type="submit" class="text-success hover:opacity-80 text-sm">{{ 'payment.action.validate'|trans }}</button>
                                        </form>
                                    {% endif %}
                                    <a href="{{ path('payment_edit', {id: payment.id}) }}" class="text-brand hover:text-brand-strong text-sm">{{ 'common.action.edit'|trans }}</a>
                                    {% if payment is same as(subscription.latestPayment) %}
                                        <form action="{{ path('payment_delete', {id: payment.id}) }}" method="POST" class="payment-delete-form inline-block" data-turbo-confirm="{{
                                            'payment.delete_confirm.base'|trans
                                            ~ (subscription.removalRollsBackAnchor(payment)
                                                ? 'payment.delete_confirm.rollback'|trans({'%from%': subscription.nextRenewal|user_date, '%to%': subscription.renewalAfterRemoving(payment)|user_date})
                                                : '')
                                            ~ (subscription.removalSwitchesToManual(payment)
                                                ? 'payment.delete_confirm.manual'|trans
                                                : '') }}">
                                            <button type="submit" class="text-danger hover:opacity-80 text-sm">{{ 'common.action.delete'|trans }}</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-fg-muted">{{ 'payment.show.empty'|trans }}</p>
            {% endif %}
        </div>

        <div class="bg-surface shadow-md rounded p-6">
            <h2 class="text-xl font-semibold mb-4">{{ 'subscription.show.history_heading'|trans }}</h2>

            {% if subscription.subscriptionEvents|length > 0 %}
                <ul class="divide-y divide-line">
                    {% for event in subscription.subscriptionEvents %}
                        <li class="py-3">
                            <div class="flex justify-between items-center">
                                <span class="text-fg">{{ event.type.label|trans }}</span>
                                <span class="text-fg-muted">{{ event.createdAt|user_datetime }}</span>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-fg-muted">{{ 'subscription.show.history_empty'|trans }}</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
