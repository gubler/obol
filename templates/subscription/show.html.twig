{% extends 'base.html.twig' %}

{% block title %}{{ subscription.name }}{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="mb-6">
            <a href="{{ path('subscription_index') }}" class="text-brand hover:text-brand-strong mb-4 inline-block">&larr; Back to Subscriptions</a>
            <h1 class="text-3xl font-bold">{{ subscription.name }}</h1>
            {% if not subscription.generatesPaymentsAutomatically %}
                <span class="manual-payments-badge mt-2 inline-flex items-center gap-1 rounded-full bg-warning-surface px-3 py-1 text-sm font-medium text-warning"
                      title="Record a payment or edit the subscription to restart automatic generation.">
                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4a1 1 0 0 1 1 1v10a1 1 0 1 1-2 0V5a1 1 0 0 1 1-1Zm6 0a1 1 0 0 1 1 1v10a1 1 0 1 1-2 0V5a1 1 0 0 1 1-1Z"/></svg>
                    Manual payments
                </span>
            {% endif %}
        </div>

        {% for message in app.flashes('success') %}
            <div class="flash-success bg-success-surface border border-success text-success px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="flash-error bg-danger-surface border border-danger text-danger px-4 py-3 rounded mb-4">
                {{ message }}
            </div>
        {% endfor %}

        <div class="bg-surface shadow-md rounded p-6 mb-6">
            <div class="flex justify-between items-center">
                <h2 class="text-xl font-semibold">Subscription Details</h2>
                <div class="space-x-2">
                    <a href="{{ path('subscription_edit', {id: subscription.id}) }}" class="bg-brand hover:bg-brand-strong text-on-brand font-bold py-2 px-4 rounded">
                        Edit
                    </a>
                    {% if subscription.archived %}
                        <form action="{{ path('subscription_unarchive', {id: subscription.id}) }}" method="POST" class="inline-block">
                            <button type="submit" class="bg-surface-2 text-fg hover:bg-line font-bold py-2 px-4 rounded">
                                Unarchive
                            </button>
                        </form>
                    {% else %}
                        <form action="{{ path('subscription_archive', {id: subscription.id}) }}" method="POST" class="inline-block" data-turbo-confirm="Are you sure you want to archive this subscription?">
                            <button type="submit" class="bg-surface-2 text-fg hover:bg-line font-bold py-2 px-4 rounded">
                                Archive
                            </button>
                        </form>
                    {% endif %}
                    <form action="{{ path('subscription_delete', {id: subscription.id}) }}" method="POST" class="inline-block" data-turbo-confirm="Are you sure you want to delete this subscription?">
                        <button type="submit" class="bg-danger text-white hover:opacity-90 font-bold py-2 px-4 rounded">
                            Delete
                        </button>
                    </form>
                </div>
            </div>

            <dl class="mt-4 space-y-2">
                <div>
                    <dt class="text-sm font-medium text-fg-muted">Category</dt>
                    <dd class="text-lg text-fg">{{ subscription.category ? subscription.category.name : 'Uncategorized' }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-fg-muted">Cost</dt>
                    <dd class="text-lg text-fg">{{ subscription.cost.format() }} / {{ subscription.paymentPeriod.value }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-fg-muted">Next Renewal</dt>
                    <dd class="text-lg text-fg">{{ subscription.nextRenewal|date('Y-m-d') }}</dd>
                </div>
                {% if subscription.description %}
                <div>
                    <dt class="text-sm font-medium text-fg-muted">Description</dt>
                    <dd class="text-lg text-fg">{{ subscription.description }}</dd>
                </div>
                {% endif %}
                {% if subscription.link %}
                <div>
                    <dt class="text-sm font-medium text-fg-muted">Link</dt>
                    <dd class="text-lg text-fg"><a href="{{ subscription.link }}" target="_blank" class="text-brand hover:text-brand-strong">{{ subscription.link }}</a></dd>
                </div>
                {% endif %}
            </dl>
        </div>

        <div class="payments-section bg-surface shadow-md rounded p-6 mb-6">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-semibold">Payments</h2>
                <a href="{{ path('payment_new', {subscriptionId: subscription.id}) }}" class="bg-brand hover:bg-brand-strong text-on-brand font-bold py-2 px-4 rounded">
                    Add Payment
                </a>
            </div>

            {% if subscription.payments|length > 0 %}
                <ul class="divide-y divide-line">
                    {% for payment in subscription.payments %}
                        <li class="py-3">
                            <div class="flex justify-between items-center">
                                <div>
                                    <span class="text-fg">{{ payment.paidDate|date('Y-m-d') }}</span>
                                    <span class="ml-2 text-xs text-fg-muted">{{ payment.type.value }}</span>
                                </div>
                                <div class="flex items-center space-x-3">
                                    <span class="text-fg-muted">{{ payment.amount.format() }}</span>
                                    {% if payment.type.value == 'generated' %}
                                        <form action="{{ path('payment_validate', {id: payment.id}) }}" method="POST" class="payment-validate-form inline-block">
                                            <button type="submit" class="text-success hover:opacity-80 text-sm">Validate</button>
                                        </form>
                                    {% endif %}
                                    <a href="{{ path('payment_edit', {id: payment.id}) }}" class="text-brand hover:text-brand-strong text-sm">Edit</a>
                                    {% if payment is same as(subscription.latestPayment) %}
                                        <form action="{{ path('payment_delete', {id: payment.id}) }}" method="POST" class="payment-delete-form inline-block" data-turbo-confirm="{{
                                            'Delete this payment?'
                                            ~ (subscription.removalRollsBackAnchor(payment)
                                                ? ' This rolls the next renewal back from ' ~ subscription.nextRenewal|date('Y-m-d') ~ ' to ' ~ subscription.renewalAfterRemoving(payment)|date('Y-m-d') ~ '.'
                                                : '')
                                            ~ (subscription.removalSwitchesToManual(payment)
                                                ? ' It also switches this subscription to manual payments.'
                                                : '') }}">
                                            <button type="submit" class="text-danger hover:opacity-80 text-sm">Delete</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-fg-muted">No payments recorded</p>
            {% endif %}
        </div>

        <div class="bg-surface shadow-md rounded p-6">
            <h2 class="text-xl font-semibold mb-4">History</h2>

            {% if subscription.subscriptionEvents|length > 0 %}
                <ul class="divide-y divide-line">
                    {% for event in subscription.subscriptionEvents %}
                        <li class="py-3">
                            <div class="flex justify-between items-center">
                                <span class="text-fg">{{ event.type.value }}</span>
                                <span class="text-fg-muted">{{ event.createdAt|date('Y-m-d H:i') }}</span>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-fg-muted">No history available</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
